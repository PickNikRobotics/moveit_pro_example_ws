<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Draw">
  <!--//////////-->
  <BehaviorTree
    ID="Draw"
    _description="Read a trajectory from a YAML file and draw it on a flat surface using Cartesian planning."
    _favorite="false"
    _hardcoded="false"
  >
    <Control ID="Parallel" failure_count="1" success_count="1">
      <Action
        ID="PublishTF"
        pose="{center}"
        child_frame_id="local"
        publish_rate="50"
      />
      <Control ID="Sequence" name="TopLevelSequence">
        <Action
          ID="SwitchController"
          activate_asap="true"
          automatic_deactivation="true"
          controller_list_action_name="/controller_manager/list_controllers"
          controller_switch_action_name="/controller_manager/switch_controller"
          strictness="1"
          timeout="-1.000000"
          activate_controllers="{controller_name}"
        />
        <Action
          ID="LoadPoseStampedVectorFromYaml"
          output="{pose_stamped_msgs}"
          file_path="{file_path}"
        />
        <Action
          ID="VisualizePath"
          marker_lifetime="0.000000"
          path="{pose_stamped_msgs}"
          marker_name="path"
          pose_marker_size="0.100000"
          show_poses="false"
        />
        <Action
          ID="PlanCartesianPath"
          path="{pose_stamped_msgs}"
          cartesian_constraint="[{constraint_type: position_and_orientation}]"
          blending_radius="0.000001"
          trajectory_timing="[{mode: time_optimal, velocity_scale_factor: 0.1, acceleration_scale_factor: 0.05}]"
          joint_trajectory_msg="{joint_trajectory_msg}"
          debug_solution="{debug_solution}"
          ik_cartesian_space_density="0.01000"
          ik_joint_space_density="0.050000"
          tip_offset="0;0;0.005;0;0;0"
          planning_group_name="{planning_group_name}"
          tip_links="{tip_link}"
        />
        <Action
          ID="ExecuteTrajectory"
          controller_action_name="{execute_follow_joint_trajectory_action_name}"
        />
        <!-- Lift clear of the surface before anything plans back to Home: the stroke ends a few
             millimetres above the table, and from there some elbow configurations route home
             straight through it. -->
        <Action
          ID="InitializeMTCTask"
          task="{mtc_task}"
          task_id="draw_retreat"
          timeout="-1.000000"
        />
        <Action ID="SetupMTCCurrentState" task="{mtc_task}" />
        <Action
          ID="SetupMTCMoveAlongFrameAxis"
          task="{mtc_task}"
          axis_frame="odom"
          axis_x="0.000000"
          axis_y="0.000000"
          axis_z="1.000000"
          min_distance="0.1"
          max_distance="0.1"
          planning_group_name="{planning_group_name}"
          hand_frame="{tip_link}"
          velocity_scale="1.000000"
          acceleration_scale="1.000000"
          ignore_environment_collisions="false"
        />
        <Action ID="PlanMTCTask" task="{mtc_task}" solution="{mtc_solution}" />
        <SubTree
          ID="Execute MTC Solution"
          _collapsed="true"
          controller_names="{controller_name}"
          controller_action_name="{execute_follow_joint_trajectory_action_name}"
          solution="{mtc_solution}"
        />
      </Control>
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Draw">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Motion - Execute" />
      </MetadataFields>
      <inout_port name="center" default="{pose_stamped}" />
      <inout_port name="controller_name" default="{controller_names}" />
      <inout_port
        name="execute_follow_joint_trajectory_action_name"
        default="{execute_follow_joint_trajectory_action_name}"
      />
      <inout_port name="file_path" default="{file_path}" />
      <inout_port name="planning_group_name" default="{planning_group_name}" />
      <inout_port name="tip_link" default="{tip_link}" />
    </SubTree>
  </TreeNodesModel>
</root>

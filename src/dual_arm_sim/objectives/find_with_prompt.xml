<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Find with prompt">
  <!--//////////-->
  <BehaviorTree ID="Find with prompt" _description="" _favorite="false">
    <Control ID="Sequence" name="TopLevelSequence">
      <Action ID="Script" code="detections_empty := false" />
      <SubTree
        ID="Segment Point Cloud from Text Prompt Subtree"
        _collapsed="false"
        camera_topic_name="/scene_camera/camera_info"
        image_topic_name="/scene_camera/color"
        masks_visualization_topic="/masks_visualization"
        model_package="moveit_pro_sam3"
        points_topic_name="/scene_camera/points"
        text_prompt="{prompt}"
        confidence_threshold="0.5"
        masks3d="{masks3d}"
        point_cloud="{point_cloud}"
        point_cloud_vector="{point_cloud_vector}"
        use_latest_transform="true"
      />
      <Action
        ID="GetSizeOfVector"
        vector_in="{point_cloud_vector}"
        vector_size="{detection_count}"
      />
      <Action ID="Script" code="detections_empty = detection_count == 0" />
      <Condition ID="ScriptCondition" code="!detections_empty" />
      <Action
        ID="GetElementOfVector"
        index="0"
        vector_in="{point_cloud_vector}"
        element="{object_cloud}"
      />
      <!-- The overhead view is dominated by the block top; mask edges can also contain sides, table or floor. -->
      <Action
        ID="ExtractDominantPlaneFromPointCloud"
        point_cloud="{object_cloud}"
        plane_point_cloud="{object_surface}"
        inlier_tolerance="0.001"
        min_inlier_fraction="0.6"
      />
      <Action
        ID="GetCentroidFromPointCloud"
        output_pose="{object_centroid}"
        point_cloud="{object_surface}"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="pose"
        marker_size="0.100000"
        pose="{object_centroid}"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Find with prompt">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Motion - Execute" />
      </MetadataFields>
      <output_port
        name="detections_empty"
        default="{detections_empty}"
        type="bool"
      >
        True only when segmentation succeeded with no objects; failures leave
        this false.
      </output_port>
      <inout_port name="object_centroid" default="{object_centroid}" />
      <inout_port name="prompt" default="{prompt}" />
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Find with prompt">
  <!--//////////-->
  <BehaviorTree
    ID="Find with prompt"
    _description="Segments the scene with the given text prompt and reports the centroid of the first mask in the detector's output order, which is not a ranking. Fails when no detection passes confidence_threshold."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <SubTree
        ID="Segment Point Cloud from Text Prompt Subtree"
        _collapsed="false"
        camera_topic_name="/scene_camera/camera_info"
        image_topic_name="/scene_camera/color"
        masks_visualization_topic="/masks_visualization"
        model_package="moveit_pro_sam3"
        points_topic_name="/scene_camera/points"
        text_prompt="{prompt}"
        confidence_threshold="0.5"
        masks3d="{masks3d}"
        point_cloud="{point_cloud}"
        point_cloud_vector="{point_cloud_vector}"
        mask_count="{mask_count}"
        use_latest_transform="true"
      />
      <Action
        ID="LogMessage"
        _skipIf="mask_count > 0"
        log_level="error"
        message="Find with prompt: no detection passed confidence_threshold for the requested prompt, so there is nothing to locate. Check the prompt port and the camera view."
      />
      <Action
        ID="GetElementOfVector"
        index="0"
        vector_in="{point_cloud_vector}"
        element="{object_cloud}"
      />
      <Action
        ID="GetCentroidFromPointCloud"
        output_pose="{object_centroid}"
        point_cloud="{object_cloud}"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="pose"
        marker_size="0.100000"
        pose="{object_centroid}"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Find with prompt">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Motion - Execute" />
      </MetadataFields>
      <inout_port name="object_centroid" default="{object_centroid}" />
      <inout_port name="prompt" default="{prompt}" />
    </SubTree>
  </TreeNodesModel>
</root>

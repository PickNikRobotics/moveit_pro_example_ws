<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Sort Blocks">
  <BehaviorTree
    ID="Sort Blocks"
    _description="Clears colored blocks off the table by color, right arm for red and left for green. Stops successfully only when both colors have no detections; perception and motion failures fail the Objective."
    _favorite="true"
  >
    <Control ID="Sequence">
      <Action
        ID="LogMessage"
        log_level="warn"
        message="Work in progress. The robot may miss blocks. Enable 'info' logs to see cycle time"
      />
      <Action
        ID="Script"
        code="cycle_failed := false; carry_speed := 0.25; carry_acceleration := carry_speed * carry_speed"
      />
      <!-- Only valid empty detections end the loop successfully; perception and motion errors stop both arms. -->
      <Decorator ID="ForceSuccess">
        <Decorator ID="KeepRunningUntilFailure">
          <Control ID="Fallback">
            <Control ID="Sequence">
              <Action ID="StopwatchBegin" timepoint="{timepoint_right}" />
              <SubTree
                ID="Find Red Block"
                _collapsed="false"
                _onFailure="cycle_failed = !detections_empty"
                object_centroid="{object_centroid}"
                detections_empty="{detections_empty}"
              />
              <Action
                ID="TransformPose"
                input_pose="{object_centroid}"
                output_pose="{object_centroid}"
                translation_xyz="0;0;-0.075"
                _onFailure="cycle_failed = true"
              />
              <Control
                ID="Sequence"
                name="Move right block"
                _onFailure="cycle_failed = true"
              >
                <SubTree ID="Open Right Gripper" _collapsed="true" />
                <SubTree
                  ID="Plan Block Transfer"
                  approach_pose="{object_centroid}"
                  planning_group="right_manipulator_without_spine"
                  hand_frame="right_fr3v2_hand_tcp"
                  place_waypoint="Place Right"
                  corner_y="-0.4"
                  carry_speed="{carry_speed}"
                  carry_acceleration="{carry_acceleration}"
                  pickup_solution="{pickup_solution}"
                  carry_solution="{carry_solution}"
                  _collapsed="true"
                />
                <SubTree
                  ID="Execute MTC Solution"
                  controller_names="right_jtac"
                  controller_action_name="/right_jtac/follow_joint_trajectory"
                  solution="{pickup_solution}"
                />
                <Action ID="WaitForDuration" delay_duration="1.0" />
                <SubTree ID="Close Right Gripper" _collapsed="true" />
                <SubTree
                  ID="Execute MTC Solution"
                  controller_names="right_jtac"
                  controller_action_name="/right_jtac/follow_joint_trajectory"
                  solution="{carry_solution}"
                />
                <SubTree ID="Open Right Gripper" _collapsed="true" />
                <SubTree
                  ID="Move to Waypoint"
                  _collapsed="true"
                  controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
                  controller_names="joint_trajectory_admittance_controller"
                  joint_group_name="manipulator"
                  waypoint_name="Home"
                />
              </Control>
              <Action ID="StopwatchEnd" timepoint="{timepoint_right}" />
            </Control>
            <Control ID="Sequence" _failureIf="cycle_failed">
              <Action ID="StopwatchBegin" timepoint="{timepoint_left}" />
              <SubTree
                ID="Find Green Block"
                _collapsed="true"
                _onFailure="cycle_failed = !detections_empty"
                object_centroid="{object_centroid}"
                detections_empty="{detections_empty}"
              />
              <Action
                ID="TransformPose"
                input_pose="{object_centroid}"
                output_pose="{object_centroid}"
                translation_xyz="0;0;-0.075"
                _onFailure="cycle_failed = true"
              />
              <Control
                ID="Sequence"
                name="Move left block"
                _onFailure="cycle_failed = true"
              >
                <SubTree ID="Open Left Gripper" _collapsed="true" />
                <SubTree
                  ID="Plan Block Transfer"
                  approach_pose="{object_centroid}"
                  planning_group="left_manipulator_without_spine"
                  hand_frame="left_fr3v2_hand_tcp"
                  place_waypoint="Place Left"
                  corner_y="0.4"
                  carry_speed="{carry_speed}"
                  carry_acceleration="{carry_acceleration}"
                  pickup_solution="{pickup_solution}"
                  carry_solution="{carry_solution}"
                  _collapsed="true"
                />
                <SubTree
                  ID="Execute MTC Solution"
                  solution="{pickup_solution}"
                  controller_names="left_jtac"
                  controller_action_name="/left_jtac/follow_joint_trajectory"
                />
                <Action ID="WaitForDuration" delay_duration="1.0" />
                <SubTree ID="Close Left Gripper" _collapsed="true" />
                <SubTree
                  ID="Execute MTC Solution"
                  solution="{carry_solution}"
                  controller_names="left_jtac"
                  controller_action_name="/left_jtac/follow_joint_trajectory"
                />
                <SubTree ID="Open Left Gripper" _collapsed="true" />
                <SubTree
                  ID="Move to Waypoint"
                  _collapsed="true"
                  controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
                  controller_names="joint_trajectory_admittance_controller"
                  joint_group_name="manipulator"
                  waypoint_name="Home"
                />
              </Control>
              <Action ID="StopwatchEnd" timepoint="{timepoint_left}" />
            </Control>
          </Control>
        </Decorator>
      </Decorator>
      <Condition ID="ScriptCondition" code="!cycle_failed" />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Sort Blocks">
      <MetadataFields>
        <Metadata subcategory="Motion - Execute" />
        <Metadata runnable="true" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<launch>
  <include
    file="$(find-pkg-share moveit_studio_agent)/launch/runtime_services.launch.xml"
  />

  <!-- Nyx path-traced scene_camera for MOVEIT_PRO_CAMERA_RENDERER nyx or both. The robot
       description defines the values and the default, and fails on any other. -->
  <let name="camera_renderer" value="$(env MOVEIT_PRO_CAMERA_RENDERER '')" />
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera.launch.py"
    if="$(eval '&quot;$(var camera_renderer)&quot; in (&quot;nyx&quot;, &quot;both&quot;)')"
  >
    <arg name="mjcf" value="$(find-pkg-share lab_sim)/description/scene.xml" />
    <arg
      name="scene_dir"
      value="$(env USER_WS $(env HOME)/user_ws)/.nyx_scenes/lab_sim"
    />
    <arg name="camera" value="scene_camera" />
    <arg
      name="topic_namespace"
      value="$(eval '&quot;nyx&quot; if &quot;$(var camera_renderer)&quot; == &quot;both&quot; else &quot;&quot;')"
    />
  </include>
</launch>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Add Poses to MTC Task">
  <!--//////////-->
  <BehaviorTree
    ID="Add Poses to MTC Task"
    _description="Initializes a new MTC task with the current state and adds a sequence of target poses."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <Action ID="InitializeMTCTask" task="{mtc_task}" />
      <!--Start the MTC task from the robot's current pose-->
      <Action ID="SetupMTCCurrentState" task="{mtc_task}" />
      <!--Use a script with a pose counter so we can give a unique name to each marker (allowing multiple poses to be visualized)-->
      <Action ID="Script" code="pose_ctr := 0" />
      <Decorator
        ID="ForEach"
        vector_in="{target_poses}"
        out="{target_pose}"
        index="{index}"
      >
        <Control ID="Sequence">
          <!--Visualize and add each pose to the vector-->
          <Action
            ID="VisualizePose"
            marker_name="{pose_ctr}"
            pose="{target_pose}"
            marker_lifetime="0.000000"
            marker_size="0.100000"
          />
          <Action ID="Script" code="pose_ctr += 1" />
          <Control ID="Sequence" name="Setup pose motion">
            <Control ID="Sequence" name="Wrap target pose">
              <Action
                ID="ResetPoseStampedVector"
                vector="{setup_mtc_pose_targets_1}"
              />
              <Action
                ID="PushBackVector"
                input_vector="{setup_mtc_pose_targets_1}"
                element="{target_pose}"
                output_vector="{setup_mtc_pose_targets_1}"
              />
              <Action ID="Script" code="setup_mtc_pose_max_ik_1 := 8" />
              <Decorator
                ID="Precondition"
                if="setup_mtc_pose_max_ik_1 == 0"
                else="SUCCESS"
              >
                <Action ID="Script" code="setup_mtc_pose_max_ik_1 = 8" />
              </Decorator>
            </Control>
            <Action
              ID="SetupMTCConnectWithProRRT"
              planning_group_name="{planning_group_name}"
              velocity_scale_factor="1.000000"
              acceleration_scale_factor="1.000000"
              trajectory_sampling_rate="100"
              max_iterations="5000"
              task="{mtc_task}"
            />
            <Action
              ID="SetupMTCBatchPoseIK"
              task="{mtc_task}"
              target_poses="{setup_mtc_pose_targets_1}"
              monitored_stage="current state"
              ik_group="{planning_group_name}"
              end_effector_link="{ik_frame}"
              end_effector_group=""
              ik_timeout_s="1.0"
              max_ik_solutions="{setup_mtc_pose_max_ik_1}"
              spawn_top_k="0"
            />
          </Control>
        </Control>
      </Decorator>
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Add Poses to MTC Task">
      <MetadataFields>
        <Metadata subcategory="Motion - Task Planning" />
        <Metadata runnable="false" />
      </MetadataFields>
      <inout_port name="ik_frame" default="grasp_link" />
      <inout_port name="mtc_task" default="{mtc_task}" />
      <inout_port name="planning_group_name" default="manipulator" />
      <inout_port name="target_poses" default="{target_poses}" />
    </SubTree>
  </TreeNodesModel>
</root>

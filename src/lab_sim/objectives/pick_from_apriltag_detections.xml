<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Pick from AprilTag Detections">
  <BehaviorTree
    ID="Pick from AprilTag Detections"
    _description="Selects the first AprilTag detection, transforms its pose, and picks the labeled object."
  >
    <Control ID="Sequence" name="Pick from AprilTag Detections">
      <Action
        ID="GetDetectionPose"
        detection_pose="{detection_pose}"
        detections="{detections}"
        target_id="-1"
        target_label=""
      />
      <Action
        ID="TransformPoseFrame"
        input_pose="{detection_pose}"
        output_pose="{detection_pose}"
        target_frame_id="world"
      />
      <Action
        ID="TransformPose"
        output_pose="{offset_pose}"
        input_pose="{detection_pose}"
        quaternion_xyzw="1;0;0;0"
        translation_xyz="0;0;-.015"
        marker_lifetime="0.000000"
        marker_size="0.100000"
        marker_text=""
        visualize_pose="false"
      />
      <Action
        ID="VisualizePose"
        name="VisualizePose"
        marker_text="Grasp Pose"
        marker_name="grasp_pose"
        marker_lifetime="0.000000"
        marker_size="0.100000"
        pose="{offset_pose}"
      />
      <SubTree
        ID="Pick from Pose"
        _collapsed="true"
        grasp_pose="{offset_pose}"
        approach_distance="0.1"
        retract_xyz="0;0;-0.1"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Pick from AprilTag Detections">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="AprilTag" />
      </MetadataFields>
      <inout_port name="detections" default="{detections}" />
    </SubTree>
  </TreeNodesModel>
</root>

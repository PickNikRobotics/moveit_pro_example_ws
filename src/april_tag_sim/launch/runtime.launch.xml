<?xml version="1.0" encoding="UTF-8" ?>
<launch>
  <include
    file="$(find-pkg-share moveit_studio_agent)/launch/runtime_services.launch.xml"
  />

  <!-- Nyx path-traced cameras, started only when this config asks for them. The same
       MOVEIT_PRO_CAMERA_RENDERER the robot description reads decides which MuJoCo camera
       topics exist, so the two renderers cannot both be on by accident or both off unnoticed.

       This config is the one place a renderer can be measured rather than eyeballed: its
       Objective records each detection's deviation from ground truth, over six tags at two
       incidences, so the same benchmark runs against either renderer and the numbers compare
       directly. Export the scene first: `ros2 run picknik_nyx_renderer nyx_export_scene`. -->
  <let
    name="camera_renderer"
    value="$(env MOVEIT_PRO_CAMERA_RENDERER mujoco)"
  />
  <!-- One sidecar per camera; this config has two. -->
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera_sidecar.launch.py"
    if="$(eval '&quot;$(var camera_renderer)&quot; in (&quot;nyx&quot;, &quot;both&quot;)')"
  >
    <arg name="mjcf" value="$(find-pkg-share april_tag_sim)/description/scene.xml" />
    <arg
      name="scene_dir"
      value="$(env USER_WS $(env HOME)/user_ws)/.nyx_scenes/april_tag_sim"
    />
    <arg name="camera" value="scene_camera" />
  </include>
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera_sidecar.launch.py"
    if="$(eval '&quot;$(var camera_renderer)&quot; in (&quot;nyx&quot;, &quot;both&quot;)')"
  >
    <arg name="mjcf" value="$(find-pkg-share april_tag_sim)/description/scene.xml" />
    <arg
      name="scene_dir"
      value="$(env USER_WS $(env HOME)/user_ws)/.nyx_scenes/april_tag_sim"
    />
    <arg name="camera" value="wrist_camera" />
  </include>
</launch>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="husky_a300">
  <!-- Real A300 platform body, sourced entirely from clearpathrobotics/clearpath_common's own
       (public, BSD-licensed) clearpath_platform_description package. No customer-specific
       description source is vendored or copied here; the macro composition below was confirmed to
       match the vendor description this platform ships with, differing only in an unused xacro arg
       and in which drivetrain file supplies the ros2_control block - irrelevant here, since
       use_platform_controllers:=false skips that include entirely and this file declares its own
       mock ros2_control block below. -->
  <xacro:arg name="use_platform_controllers" default="false" />
  <!-- a300.urdf.xacro declares this arg with a default that resolves $(find clearpath_control), a
       package this config never uses (no Gazebo) and does not vendor. Declaring it first wins: xacro
       only applies an <xacro:arg> default for a name it has not already seen, so the upstream
       default is never evaluated. -->
  <xacro:arg name="gazebo_controllers" default="unused" />
  <xacro:include filename="$(find clearpath_platform_description)/urdf/common.urdf.xacro" />
  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/a300.urdf.xacro" />
  <xacro:a300 control="diff_4wd" front_wheels="outdoor" rear_wheels="outdoor" />

  <!-- Known upstream artifact: a300.urdf.xacro's own base_footprint_joint (chassis_link ->
       base_footprint, origin z=front_wheel_radius) puts base_footprint 0.30 m ABOVE true ground
       contact instead of on it - the sign should carry the wheel-center offset the other way.
       FK-measured against this file's own generated URDF: base_link=[0,0,0], front wheel
       centers=[...,0.0291], wheel radius=0.1651 -> true ground contact is 0.13597 m BELOW
       base_link. We can't fix that vendored joint in place (it would mean editing the vendored
       clearpath_platform_description package, which this file keeps byte-identical to upstream)
       and we can't add a second link literally named "base_footprint" either (URDF requires
       unique link names; confirmed check_urdf rejects the duplicate). So this adds a
       REP105-shaped ground frame under a different name, "footprint", that becomes base_link's
       real parent - the wheel-radius/wheel-center numbers above are the platform_velocity_
       controller's own SRDF/description geometry, not customer-specific measurements. -->
  <link name="footprint" />
  <joint name="footprint_joint" type="fixed">
    <parent link="footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.13597" rpy="0 0 0" />
  </joint>

  <!-- Attachments: the standard A300 accessory kit (front/rear bumper, sensor enclosure, sensor
       arch), for visual/body fidelity with the real robot. No sensors are mounted - sensors are out
       of scope for this configuration. -->
  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/bumper.urdf.xacro" />
  <xacro:bumper name="front_bumper" model="default" parent_link="front_bumper_mount" extension="0.0">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </xacro:bumper>
  <xacro:bumper name="rear_bumper" model="default" parent_link="rear_bumper_mount" extension="0.0">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </xacro:bumper>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/amp_enclosure.urdf.xacro" />
  <xacro:amp_enclosure name="enclosure" model="amp_enclosure" parent_link="base_link">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </xacro:amp_enclosure>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/amp_sensor_arch.urdf.xacro" />
  <xacro:amp_sensor_arch name="sensor_arch" model="amp_sensor_arch" parent_link="enclosure_antenna_mount">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </xacro:amp_sensor_arch>

  <!-- Mock hardware: command velocity in, integrated position/velocity state out. No physics, no
       sensors - this is the "blank world", fast-iteration counterpart to a full MuJoCo simulation.
       Wheel joint names match clearpath_platform_description/urdf/a300/drivetrain/wheels/outdoor.urdf.xacro
       (front_left_wheel_joint etc.), the same names the real robot's drivetrain.urdf.xacro claims. -->
  <ros2_control name="husky_a300_hardware" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">true</param>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
</robot>

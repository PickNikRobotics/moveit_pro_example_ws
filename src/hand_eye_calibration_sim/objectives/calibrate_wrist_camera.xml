<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Calibrate Wrist Camera">
  <!--//////////-->
  <BehaviorTree
    ID="Calibrate Wrist Camera"
    _description="Calibrate the pose of the wrist camera from views of the world board, and draw the solved camera and board poses in the 3D view. Run Generate Extrinsic Calibration Waypoints first. See the Camera Calibration guide at https://docs.picknik.ai/how_to/robotics_applications/camera_calibration/."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <SubTree
        ID="Calibrate Eye In Hand Camera"
        _collapsed="true"
        image_topic="/wrist_camera/color"
        camera_info_topic="/wrist_camera/camera_info"
        camera_name="wrist_camera"
        point_cloud_topic="/wrist_camera/points"
        joint_group_name="manipulator"
        end_effector_frame="grasp_link"
        base_frame="world"
        board="[{squares_x: 7, squares_y: 5, square_length: 0.05, marker_length: 0.037143, dictionary: DICT_4X4_50}]"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Calibrate Wrist Camera">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Perception - Camera Calibration" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

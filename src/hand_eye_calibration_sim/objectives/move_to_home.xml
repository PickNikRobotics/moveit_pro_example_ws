  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Move to Home">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Motion - Execute" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Plan Path Along Surface">
  <BehaviorTree
    ID="Plan Path Along Surface"
    _description="Plan and execute a path following a surface"
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        joint_group_name="manipulator"
        collision_check_params="[{override_scene_link_padding: true, link_padding: 0.0}]"
        seed="0"
        velocity_scale_factor="1.0"
        waypoint_name="View bowls"
        execution_pipeline="jtac"
        orientation_constraint="[]"
      />
      <!--Get a point cloud and crop it to the area of interest-->
      <Action
        ID="GetPointCloud"
        topic_name="/scene_camera/points"
        message_out="{point_cloud}"
        publisher_timeout_sec="5.000000"
        message_timeout_sec="5.000000"
      />
      <Action
        ID="TransformPointCloudFrame"
        input_cloud="{point_cloud}"
        output_cloud="{point_cloud}"
        target_frame="world"
      />
      <Action
        ID="CreatePoseStamped"
        reference_frame="world"
        pose_stamped="{roi_frame}"
        position_xyz="0.6;0.2;0.9"
        orientation_xyzw="0.707; 0.000; 0.000; 0.707"
      />
      <Action
        ID="CropPointsInBox"
        crop_box_centroid_pose="{roi_frame}"
        point_cloud="{point_cloud}"
        point_cloud_cropped="{point_cloud}"
        crop_box_size="0.4;0.2;0.1"
      />
      <Action
        ID="SendPointCloudToUI"
        pcd_topic="/pcd_pointcloud_captures"
        point_cloud="{point_cloud}"
      />
      <!--Get the centroid of the cropped point cloud and use it to get a vertical contour-->
      <Action
        ID="GetCentroidFromPointCloud"
        output_pose="{centroid}"
        point_cloud="{point_cloud}"
      />
      <Action
        ID="TransformPose"
        input_pose="{centroid}"
        output_pose="{centroid}"
        quaternion_xyzw="0.707; 0.000; 0.000; 0.707"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="centroid"
        marker_size="0.01000"
        pose="{centroid}"
      />
      <Action
        ID="GetContourFromPointCloudSlice"
        contour_path="{contour_path}"
        max_pose_spacing="0.020000"
        hull_alpha="-1.000000"
        input_cloud="{point_cloud}"
        slice_distance_from_plane="0.100000"
        slice_plane="{centroid}"
        contour_crop_angle_span="3.18"
        contour_crop_angle_start="1.65"
      />
      <!--
        Offset every contour pose 0.1 m back along its own z-axis, so the tool stands off the surface. Plan Path With
        MTC places grasp_link exactly on each waypoint, so the standoff is applied to the path instead of as a tip
        offset.
      -->
      <Action ID="ResetVector" vector="{tool_path}" />
      <Decorator
        ID="ForEach"
        index="{contour_index}"
        out="{contour_pose}"
        vector_in="{contour_path}"
      >
        <Control ID="Sequence">
          <Action
            ID="TransformPose"
            input_pose="{contour_pose}"
            output_pose="{tool_pose}"
            translation_xyz="0;0;-0.1"
          />
          <Action
            ID="PushBackVector"
            input_vector="{tool_path}"
            element="{tool_pose}"
            output_vector="{tool_path}"
          />
        </Control>
      </Decorator>
      <Action
        ID="VisualizePath"
        marker_lifetime="0.000000"
        marker_name="path"
        path="{tool_path}"
        pose_marker_size="0.04000"
        show_poses="true"
      />
      <!--
        Move to the first waypoint and follow the rest of the path. A broad IK search at the first waypoint
        (max_ik_solutions) gives Path IK many start configurations to try; lower it if planning takes too long.
      -->
      <SubTree
        ID="Plan Path With MTC"
        _collapsed="true"
        path="{tool_path}"
        planning_group_name="manipulator"
        ik_frame="grasp_link"
        end_effector_group="fanuc_ee"
        max_ik_solutions="4"
        ik_timeout_s="1.0"
        blending_radius="0.005"
        solution="{mtc_solution}"
      />
      <SubTree
        ID="Execute MTC Solution"
        solution="{mtc_solution}"
        goal_duration_tolerance="-1.0"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Plan Path Along Surface">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Motion - Planning" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

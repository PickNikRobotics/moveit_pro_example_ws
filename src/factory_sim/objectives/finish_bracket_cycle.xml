<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Finish Bracket Cycle">
  <BehaviorTree
    ID="Finish Bracket Cycle"
    _description="Completes the jig operation, right-bin placement, and return to Home."
  >
    <Control ID="Sequence">
      <Action ID="StopwatchBegin" timepoint="{t_finish}" />
      <Control ID="IfThenElse">
        <Condition ID="IsLookaheadEnabled" enabled="{near_jig_wait}" />
        <Action ID="AlwaysSuccess" />
        <SubTree
          ID="Execute MTC Solution"
          _collapsed="true"
          solution="{home_solution}"
          goal_duration_tolerance="30.0"
        />
      </Control>
      <Action
        ID="LogMessage"
        log_level="info"
        message="JIG: processing started."
      />
      <SubTree ID="Indicate Jig Working" _collapsed="true" />
      <Action ID="WaitForDuration" delay_duration="2" />
      <Action
        ID="LogMessage"
        log_level="info"
        message="JIG: processing completed."
      />
      <SubTree ID="Indicate Part Ready" _collapsed="true" />
      <Control ID="IfThenElse">
        <Condition ID="IsLookaheadEnabled" enabled="{cache_transfers}" />
        <SubTree
          ID="Pick Bracket Part from Jig with Cached Motions"
          _collapsed="true"
          part_name="{part_name}"
          cache_transfers="{cache_transfers}"
          jig_approach_ready="{jig_approach_ready}"
          jig_approach_solution="{jig_approach_solution}"
          jig_contact_ready="{jig_contact_ready}"
          jig_contact_solution="{jig_contact_solution}"
          jig_retreat_ready="{jig_retreat_ready}"
          jig_retreat_solution="{jig_retreat_solution}"
        />
        <SubTree
          ID="Pick Bracket Part from Jig Subtree"
          part_name="{part_name}"
        />
      </Control>
      <SubTree ID="Indicate Jig Empty" _collapsed="true" />
      <Control ID="IfThenElse">
        <Condition ID="IsLookaheadEnabled" enabled="{cache_transfers}" />
        <SubTree
          ID="Drop Bracket Part in Right Bin with Cached Motion"
          _collapsed="true"
          part_name="{part_name}"
          drop_pose="{drop_pose}"
          cache_transfers="{cache_transfers}"
          right_bin_ready="{right_bin_ready}"
          right_bin_solution="{right_bin_solution}"
        />
        <SubTree
          ID="Drop Bracket Part in Right Bin Subtree"
          part_name="{part_name}"
          drop_pose="{drop_pose}"
        />
      </Control>
      <Control ID="IfThenElse">
        <Condition ID="IsLookaheadEnabled" enabled="{cache_transfers}" />
        <SubTree
          ID="Return Home with Cached Motion"
          cache_transfers="{cache_transfers}"
          home_return_ready="{home_return_ready}"
          home_return_solution="{home_return_solution}"
        />
        <SubTree ID="Move to Named Waypoint" waypoint_name="Home" />
      </Control>
      <Action
        ID="StopwatchEnd"
        timepoint="{t_finish}"
        message="EXECUTION: bracket transfer and Home handoff"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Finish Bracket Cycle">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Application - Advanced Examples" />
      </MetadataFields>
      <input_port
        name="home_solution"
        type="moveit_task_constructor_msgs::msg::Solution"
      />
      <input_port
        name="part_name"
        type="std::string"
        default="single_bracket_part"
      />
      <input_port name="drop_pose" type="geometry_msgs::msg::PoseStamped" />
      <input_port name="near_jig_wait" type="bool" default="false" />
      <input_port name="cache_transfers" type="bool" default="false" />
      <inout_port
        name="jig_approach_ready"
        type="bool"
        default="{jig_approach_ready}"
      />
      <inout_port
        name="jig_approach_solution"
        type="moveit_task_constructor_msgs::msg::Solution"
        default="{jig_approach_solution}"
      />
      <inout_port
        name="jig_contact_ready"
        type="bool"
        default="{jig_contact_ready}"
      />
      <inout_port
        name="jig_contact_solution"
        type="moveit_task_constructor_msgs::msg::Solution"
        default="{jig_contact_solution}"
      />
      <inout_port
        name="jig_retreat_ready"
        type="bool"
        default="{jig_retreat_ready}"
      />
      <inout_port
        name="jig_retreat_solution"
        type="moveit_task_constructor_msgs::msg::Solution"
        default="{jig_retreat_solution}"
      />
      <inout_port
        name="right_bin_ready"
        type="bool"
        default="{right_bin_ready}"
      />
      <inout_port
        name="right_bin_solution"
        type="moveit_task_constructor_msgs::msg::Solution"
        default="{right_bin_solution}"
      />
      <inout_port
        name="home_return_ready"
        type="bool"
        default="{home_return_ready}"
      />
      <inout_port
        name="home_return_solution"
        type="moveit_task_constructor_msgs::msg::Solution"
        default="{home_return_solution}"
      />
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Execute Prepared Bracket Pick">
  <BehaviorTree
    ID="Execute Prepared Bracket Pick"
    _description="Executes a planned suction pick and attaches the bracket collision model to tool0."
  >
    <Control ID="Sequence" name="Execute prepared bracket pick">
      <SubTree ID="Activate Vacuum" _collapsed="true" />
      <Action ID="StopwatchBegin" timepoint="{t_exec}" />
      <SubTree
        ID="Execute MTC Solution"
        solution="{solution}"
        goal_duration_tolerance="30.0"
      />
      <Action
        ID="StopwatchEnd"
        timepoint="{t_exec}"
        message="EXECUTION: vacuum pick from bin"
      />
      <Action ID="StopwatchBegin" timepoint="{t_scene}" />
      <Action
        ID="AddURDF"
        urdf_name="{part_name}"
        urdf_pose="{bracket_part_pose}"
        package_name="factory_sim"
        urdf_file_path="description/simple_bracket_collision_geometry.urdf"
      />
      <Action
        ID="AttachURDF"
        urdf_name="{part_name}"
        allowed_collision_links="link_5;link_6"
        parent_link_name="tool0"
      />
      <Action
        ID="StopwatchEnd"
        timepoint="{t_scene}"
        message="SCENE: attach bracket to tool"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Execute Prepared Bracket Pick">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Application - Advanced Examples" />
      </MetadataFields>
      <input_port
        name="bracket_part_pose"
        type="geometry_msgs::msg::PoseStamped"
      />
      <input_port
        name="solution"
        type="moveit_task_constructor_msgs::msg::Solution"
      />
      <input_port
        name="part_name"
        type="std::string"
        default="single_bracket_part"
      />
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Plan Bracket Pick">
  <BehaviorTree
    ID="Plan Bracket Pick"
    _description="Plans a suction approach from the current state or the final scene of a previous solution."
  >
    <Control ID="Sequence" name="Plan bracket approach">
      <Action
        ID="TransformPose"
        input_pose="{bracket_part_pose}"
        output_pose="{pick_pose}"
        translation_xyz=".164;-0.080;0.01"
        name="Create pick pose for the bracket part"
      />
      <Action ID="ResetPoseStampedVector" vector="{approach_candidates}" />
      <Action
        ID="TransformPose"
        input_pose="{pick_pose}"
        output_pose="{yaw_pick_pose}"
        translation_xyz="0;0;0"
        quaternion_xyzw="0;0;0;1"
        name="Copy pick pose as the yaw-0 candidate"
      />
      <Action
        ID="TransformPose"
        input_pose="{yaw_pick_pose}"
        output_pose="{approach_candidate}"
        translation_xyz="0;0;0.15"
        quaternion_xyzw="-0.0; -1.0; -0.0; -0.0"
        name="Create approach pose before straight pick"
      />
      <Action
        ID="PushBackVector"
        input_vector="{approach_candidates}"
        element="{approach_candidate}"
        output_vector="{approach_candidates}"
      />
      <Decorator ID="RepeatUnlessFailureWithinTick" num_cycles="7">
        <Control
          ID="Sequence"
          name="Rotate the pick yaw 45 degrees and add the approach candidate"
        >
          <Action
            ID="TransformPose"
            input_pose="{yaw_pick_pose}"
            output_pose="{yaw_pick_pose}"
            translation_xyz="0;0;0"
            quaternion_xyzw="0;0;0.3826834;0.9238795"
          />
          <Action
            ID="TransformPose"
            input_pose="{yaw_pick_pose}"
            output_pose="{approach_candidate}"
            translation_xyz="0;0;0.15"
            quaternion_xyzw="-0.0; -1.0; -0.0; -0.0"
          />
          <Action
            ID="PushBackVector"
            input_vector="{approach_candidates}"
            element="{approach_candidate}"
            output_vector="{approach_candidates}"
          />
        </Control>
      </Decorator>
      <Action
        ID="InitializeMTCTask"
        task="{mtc_task}"
        task_id="bracket_pick_candidate"
        timeout="10.0"
      />
      <Control ID="IfThenElse">
        <Condition ID="IsLookaheadEnabled" enabled="{use_fixed_start}" />
        <Control ID="Sequence">
          <Action
            ID="SetupMTCFixedJointState"
            task="{mtc_task}"
            planning_scene_msg="{fixed_scene}"
            joint_state_msg="{fixed_joint_state}"
            ignore_collisions="true"
          />
          <Action ID="Script" code="monitored_stage := 'fixed state'" />
        </Control>
        <Control ID="IfThenElse">
          <Condition ID="IsLookaheadEnabled" enabled="{use_future_start}" />
          <Control ID="Sequence">
            <Action
              ID="SetupMTCFromSolution"
              task="{mtc_task}"
              solution="{start_solution}"
            />
            <Action ID="Script" code="monitored_stage := 'Initial state'" />
          </Control>
          <Control ID="Sequence">
            <Action ID="SetupMTCCurrentState" task="{mtc_task}" />
            <Action ID="Script" code="monitored_stage := 'current state'" />
          </Control>
        </Control>
      </Control>
      <Action
        ID="SetupMTCSetCollisionRule"
        name_a="link_5"
        name_b="link_6"
        allow_collision="true"
        task="{mtc_task}"
      />
      <Action
        ID="SetupMTCSetCollisionRule"
        name_a="link_5"
        name_b="suction_gripper"
        allow_collision="true"
        task="{mtc_task}"
      />
      <Action
        ID="SetupMTCSetCollisionRule"
        name_a="link_6"
        name_b="suction_gripper"
        allow_collision="true"
        task="{mtc_task}"
      />
      <Action
        ID="SetupMTCConnectWithProRRT"
        acceleration_scale_factor="1.000000"
        collision_check_params="[{override_scene_link_padding: true, link_padding: 0.01}]"
        max_iterations="5000"
        planning_group_name="manipulator"
        seed="0"
        task="{mtc_task}"
        trajectory_sampling_rate="100"
        velocity_scale_factor="1.000000"
      />
      <Action
        ID="SetupMTCBatchPoseIK"
        end_effector_group="fanuc_ee"
        end_effector_link="tool0"
        ik_group="manipulator"
        ik_timeout_s="0.05"
        max_ik_solutions="1"
        monitored_stage="{monitored_stage}"
        target_poses="{approach_candidates}"
        task="{mtc_task}"
      />
      <Action
        ID="SetupMTCMoveAlongFrameAxis"
        acceleration_scale="0.5"
        axis_frame="tool0"
        axis_x="0.000000"
        axis_y="0.000000"
        axis_z="1.000000"
        hand_frame="tool0"
        ignore_environment_collisions="false"
        max_distance="0.055"
        min_distance="0.055"
        planning_group_name="manipulator"
        task="{mtc_task}"
        velocity_scale="1.000000"
        name="Press suction cup onto bracket face"
      />
      <Action ID="StopwatchBegin" timepoint="{t_plan}" />
      <Action
        ID="PlanMTCTask"
        solution="{mtc_solution}"
        task="{mtc_task}"
        suppress_failure_message="true"
      />
      <Action
        ID="StopwatchEnd"
        timepoint="{t_plan}"
        message="PLANNING: vacuum pick from bin"
      />
      <Action ID="Script" code="solution := mtc_solution" />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Plan Bracket Pick">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Application - Advanced Examples" />
      </MetadataFields>
      <input_port
        name="bracket_part_pose"
        type="geometry_msgs::msg::PoseStamped"
      />
      <input_port name="use_future_start" type="bool" default="false" />
      <input_port
        name="start_solution"
        type="moveit_task_constructor_msgs::msg::Solution"
        default="{start_solution}"
      />
      <output_port
        name="solution"
        type="moveit_task_constructor_msgs::msg::Solution"
      />
      <input_port name="use_fixed_start" type="bool" default="false" />
      <input_port
        name="fixed_joint_state"
        type="sensor_msgs::msg::JointState"
        default="{fixed_joint_state}"
      />
      <input_port
        name="fixed_scene"
        type="moveit_msgs::msg::PlanningScene"
        default="{fixed_scene}"
      />
    </SubTree>
  </TreeNodesModel>
</root>

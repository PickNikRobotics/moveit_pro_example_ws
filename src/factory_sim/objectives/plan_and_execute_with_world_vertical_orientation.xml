<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="PlanAndExecuteWithPoseOrientation">
  <!--//////////-->
  <BehaviorTree
    ID="PlanAndExecuteWithPoseOrientation"
    _description="Free space plan to an approach pose then free space plan to a target pose with optional orientation constraints. With orientation constraints the gripper will maintain its orientation relative to the world vertical axis when moving from the approach to target pose."
  >
    <Control ID="Sequence" name="Plan to approach then target">
      <Action
        ID="SwitchController"
        activate_controllers="{controller_names}"
        activate_asap="true"
        automatic_deactivation="true"
        controller_list_action_name="/controller_manager/list_controllers"
        controller_switch_action_name="/controller_manager/switch_controller"
        strictness="1"
        timeout="-1.000000"
      />
      <Action
        ID="InitializeMTCTask"
        task="{mtc_task}"
        task_id="move_to_pose"
        timeout="-1.000000"
      />
      <Action ID="SetupMTCCurrentState" task="{mtc_task}" />
      <Control ID="Sequence" name="Setup pose motion">
        <Control ID="Sequence" name="Wrap target pose">
          <Action
            ID="ResetPoseStampedVector"
            vector="{setup_mtc_pose_targets_1}"
          />
          <Action
            ID="PushBackVector"
            input_vector="{setup_mtc_pose_targets_1}"
            element="{approach_pose}"
            output_vector="{setup_mtc_pose_targets_1}"
          />
          <Action ID="Script" code="setup_mtc_pose_max_ik_1 := 8" />
          <Decorator
            ID="Precondition"
            if="setup_mtc_pose_max_ik_1 == 0"
            else="SUCCESS"
          >
            <Action ID="Script" code="setup_mtc_pose_max_ik_1 = 8" />
          </Decorator>
        </Control>
        <Action
          ID="SetupMTCConnectWithProRRT"
          planning_group_name="{joint_group_name}"
          collision_check_params="[{override_scene_link_padding: true, link_padding: 0.01}]"
          velocity_scale_factor="1.000000"
          acceleration_scale_factor="1.000000"
          trajectory_sampling_rate="100"
          max_iterations="50000"
          task="{mtc_task}"
        />
        <Action
          ID="SetupMTCBatchPoseIK"
          task="{mtc_task}"
          target_poses="{setup_mtc_pose_targets_1}"
          monitored_stage="current state"
          ik_group="{joint_group_name}"
          end_effector_link="{ik_frame}"
          end_effector_group=""
          ik_timeout_s="1.0"
          max_ik_solutions="{setup_mtc_pose_max_ik_1}"
          spawn_top_k="0"
          collision_check_params="[{override_scene_link_padding: true, link_padding: 0.01}]"
        />
      </Control>
      <Control ID="Sequence" name="Setup pose motion">
        <Control ID="Sequence" name="Wrap target pose">
          <Action
            ID="ResetPoseStampedVector"
            vector="{setup_mtc_pose_targets_2}"
          />
          <Action
            ID="PushBackVector"
            input_vector="{setup_mtc_pose_targets_2}"
            element="{target_pose}"
            output_vector="{setup_mtc_pose_targets_2}"
          />
          <Action ID="Script" code="setup_mtc_pose_max_ik_2 := 8" />
          <Decorator
            ID="Precondition"
            if="setup_mtc_pose_max_ik_2 == 0"
            else="SUCCESS"
          >
            <Action ID="Script" code="setup_mtc_pose_max_ik_2 = 8" />
          </Decorator>
        </Control>
        <Action
          ID="SetupMTCConnectWithProRRT"
          planning_group_name="{joint_group_name}"
          collision_check_params="[{override_scene_link_padding: true, link_padding: 0.01}]"
          velocity_scale_factor="1.000000"
          acceleration_scale_factor="1.000000"
          trajectory_sampling_rate="100"
          orientation_constraint="{orientation_constraint}"
          max_iterations="50000"
          task="{mtc_task}"
        />
        <Action
          ID="SetupMTCBatchPoseIK"
          task="{mtc_task}"
          target_poses="{setup_mtc_pose_targets_2}"
          monitored_stage="current state"
          ik_group="{joint_group_name}"
          end_effector_link="{ik_frame}"
          end_effector_group=""
          ik_timeout_s="1.0"
          max_ik_solutions="{setup_mtc_pose_max_ik_2}"
          spawn_top_k="0"
          collision_check_params="[{override_scene_link_padding: true, link_padding: 0.01}]"
        />
      </Control>
      <Decorator
        ID="ForceSuccess"
        name="Do not terminate on planning failure or skipped execution"
      >
        <Control
          ID="IfThenElse"
          name="If we are able to plan a path, optionally execute it"
        >
          <Control ID="Sequence" name="Plan">
            <Action
              ID="PlanMTCTask"
              task="{mtc_task}"
              solution="{mtc_solution}"
            />
          </Control>
          <Control
            ID="Sequence"
            name="Optionally execute trajectory and return to start joint state"
          >
            <Action
              ID="WaitForMTCSolutionApproval"
              solution="{mtc_solution}"
              cartesian_path_links="tool0"
            />
            <Decorator
              ID="Precondition"
              else="SUCCESS"
              if="execute_trajectories == 'true'"
            >
              <Control ID="Sequence">
                <SubTree
                  ID="Execute MTC Solution"
                  controller_names="{controller_names}"
                  solution="{mtc_solution}"
                />
                <SubTree
                  ID="Move to Joint State"
                  _collapsed="false"
                  target_joint_state="{starting_joint_state}"
                  controller_action_server="{controller_action_server}"
                  controller_names="{controller_names}"
                  joint_group_name="{joint_group_name}"
                />
              </Control>
            </Decorator>
          </Control>
          <Control
            ID="IfThenElse"
            name="Notify of planning failure and pause for inspection"
          >
            <Action
              ID="LogMessage"
              log_level="warn"
              message="Pausing. Unable to plan to reachability pose. Press Resume when ready."
            />
            <Action
              ID="BreakpointSubscriber"
              breakpoint_topic="/moveit_pro_breakpoint"
            />
          </Control>
        </Control>
      </Decorator>
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="PlanAndExecuteWithPoseOrientation">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Motion - Execution" />
      </MetadataFields>
      <inout_port name="approach_pose" default="{approach_pose}" />
      <inout_port
        name="controller_action_server"
        default="{controller_action_server}"
      />
      <inout_port name="controller_names" default="{controller_names}" />
      <inout_port
        name="execute_trajectories"
        default="{execute_trajectories}"
      />
      <inout_port name="ik_frame" default="{ik_frame}" />
      <inout_port name="joint_group_name" default="{joint_group_name}" />
      <inout_port name="orientation_constraint" default="[]" />
      <inout_port
        name="starting_joint_state"
        default="{starting_joint_state}"
      />
      <inout_port name="target_pose" default="{target_pose}" />
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Navigate to Clicked Point">
  <!--//////////-->
  <BehaviorTree
    ID="Navigate to Clicked Point"
    _description="Drive the base to a point clicked in the Visualization pane, with the arms stowed first. Nav2 plans, follows and replans the path."
    _favorite="true"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <Action ID="SetInitialPose" robot_frame_id="base_link" />
      <Action
        ID="GetPoseFromUser"
        is_normal="true"
        pose_prompt="Choose a goal by clicking in the 3D Visualization pane"
        user_pose="{goal}"
        view_name="Visualization"
      />
      <SubTree
        ID="Drive Base using Nav2"
        _collapsed="true"
        goal_pose="{goal}"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Navigate to Clicked Point">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

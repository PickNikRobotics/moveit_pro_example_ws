<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Navigate with SMAC">
  <BehaviorTree
    ID="Navigate with SMAC"
    _description="Prompt for a point on the map and drive there under Nav2, with the arms stowed, planned with the Smac State Lattice planner, which checks the whole footprint along the plan: a goal where the footprint would touch an obstacle fails at once."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!-- is_normal false: a navigation goal wants an upright pose, not one tipped onto a surface normal. -->
      <Action
        ID="GetPoseFromUser"
        view_name="Visualization"
        pose_prompt="Click a point on the map to drive to"
        is_normal="false"
        user_pose="{goal_pose}"
      />
      <!-- SmacLattice is Nav2's Smac State Lattice planner. -->
      <SubTree
        ID="Drive Base using Nav2"
        _collapsed="true"
        goal_pose="{goal_pose}"
        planner_id="SmacLattice"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Navigate with SMAC">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" ?>
<package format="3">
  <name>market_sim</name>
  <version>10.2.0</version>

  <description>
    MoveIt Pro configuration for a Franka Mobile FR3 Duo in a simulated
    supermarket, with Beluga AMCL localization and Nav2 navigation.
  </description>

  <maintainer email="support@picknik.ai">MoveIt Pro Maintainer</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>beluga_amcl</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mobile_fr3_duo_mock</exec_depend>
  <exec_depend>mobile_fr3_duo_sim</exec_depend>
  <exec_depend>moveit_pro_behavior</exec_depend>
  <exec_depend>moveit_pro_objectives</exec_depend>
  <exec_depend>moveit_studio_agent</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-pil</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Interim C170 support; replace this macro with the printed CAD geometry.
       Aluminum primitive fixture, 0.431769 kg; not printed material or fabrication data. -->
  <xacro:macro name="market_livox_mid360_mount">
    <xacro:macro name="livox_support_box" params="xyz size">
      <visual>
        <origin xyz="${xyz}"/>
        <geometry><box size="${size}"/></geometry>
        <material name="livox_bracket"><color rgba="0.18 0.20 0.22 1"/></material>
      </visual>
      <collision>
        <origin xyz="${xyz}"/>
        <geometry><box size="${size}"/></geometry>
      </collision>
    </xacro:macro>
    <xacro:macro name="livox_support_rod" params="xyz rpy length">
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><cylinder radius="0.008" length="${length}"/></geometry>
        <material name="livox_bracket"/>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><cylinder radius="0.008" length="${length}"/></geometry>
      </collision>
    </xacro:macro>
    <link name="livox_mid360_mount">
      <inertial>
        <origin xyz="0 0.075877177 0.004914938"/>
        <mass value="0.431769164"/>
        <inertia ixx="0.006101791" ixy="0" ixz="0" iyy="0.003756598" iyz="0.002024248" izz="0.002793063"/>
      </inertial>
      <!-- Mount frame is at scan O; sensor hangs below the overhead plate. -->
      <xacro:livox_support_box xyz="0 0 0.0625" size="0.125 0.125 0.004"/>
      <!-- Pole just outside measured cap's left edge (y=0.1505) by its 8 mm radius.
           Its bottom is at cap z=1.461; the C170 scan origin is z=1.700. -->
      <xacro:livox_support_rod xyz="0 0.1585 -0.08825" rpy="0 0 0" length="0.3015"/>
      <xacro:livox_support_rod xyz="0 0.07925 0.0625" rpy="${-pi/2} 0 0" length="0.1585"/>
      <!-- Extend to the housing's mounting face for a connected solid support. -->
      <xacro:livox_support_rod xyz="0 0 0.04825" rpy="0 0 0" length="0.0245"/>
    </link>
  </xacro:macro>
</robot>

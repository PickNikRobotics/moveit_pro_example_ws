<?xml version="1.0" ?>
<package format="3">
  <name>kdl_gravity_compensation_controller</name>
  <version>10.3.0</version>
  <description>
    Chainable ros2_control controller that adds KDL gravity compensation to
    upstream effort references, or runs standalone as gravity-only.
  </description>
  <maintainer email="support@picknik.ai">MoveIt Pro Maintainer</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend version_gte="4.45.2">controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>kdl_parser</depend>
  <depend>orocos_kdl_vendor</depend>
  <depend>pluginlib</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>controller_manager</test_depend>
  <test_depend>controller_manager_msgs</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

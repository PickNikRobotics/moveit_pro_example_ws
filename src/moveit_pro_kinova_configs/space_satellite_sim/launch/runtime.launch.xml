<launch>
  <include
    file="$(find-pkg-share moveit_studio_agent)/launch/runtime_services.launch.xml"
  />

  <!-- Nyx path-traced cameras for MOVEIT_PRO_CAMERA_RENDERER nyx or both, one node per camera. The robot description defines the values and the default, and fails on any other. picknik_nyx_renderer is an optional dependency: only images with the Nyx runtime ship it. -->
  <let name="camera_renderer" value="$(env MOVEIT_PRO_CAMERA_RENDERER '')" />
  <let
    name="nyx_enabled"
    value="$(eval '&quot;$(var camera_renderer)&quot; in (&quot;nyx&quot;, &quot;both&quot;)')"
  />
  <let
    name="nyx_namespace"
    value="$(eval '&quot;nyx&quot; if &quot;$(var camera_renderer)&quot; == &quot;both&quot; else &quot;&quot;')"
  />
  <let
    name="vapr_enabled"
    value="$(eval '&quot;$(var camera_renderer)&quot; == &quot;vapr&quot;')"
  />
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera.launch.py"
    if="$(var nyx_enabled)"
  >
    <arg
      name="mjcf"
      value="$(find-pkg-share space_satellite_sim)/description/mujoco/scene.xml"
    />
    <arg
      name="scene_dir"
      value="$(env USER_WS $(env HOME)/user_ws)/.nyx_scenes/space_satellite_sim"
    />
    <arg name="camera" value="scene_camera" />
    <arg name="topic_namespace" value="$(var nyx_namespace)" />
  </include>
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera.launch.py"
    if="$(var nyx_enabled)"
  >
    <arg
      name="mjcf"
      value="$(find-pkg-share space_satellite_sim)/description/mujoco/scene.xml"
    />
    <arg
      name="scene_dir"
      value="$(env USER_WS $(env HOME)/user_ws)/.nyx_scenes/space_satellite_sim"
    />
    <arg name="camera" value="servicer_camera" />
    <arg name="topic_namespace" value="$(var nyx_namespace)" />
  </include>
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera.launch.py"
    if="$(var nyx_enabled)"
  >
    <arg
      name="mjcf"
      value="$(find-pkg-share space_satellite_sim)/description/mujoco/scene.xml"
    />
    <arg
      name="scene_dir"
      value="$(env USER_WS $(env HOME)/user_ws)/.nyx_scenes/space_satellite_sim"
    />
    <arg name="camera" value="wrist_camera" />
    <arg name="topic_namespace" value="$(var nyx_namespace)" />
  </include>
  <!-- VAPR (experimental) for MOVEIT_PRO_CAMERA_RENDERER vapr: one node renders the cameras the robot description hands over to it, on the topics MuJoCo would publish. It reads the URDF from robot_description and the MJCF directly, so it needs no scene export. -->
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera.launch.py"
    if="$(var vapr_enabled)"
  >
    <arg name="backend" value="vapr" />
    <arg
      name="mjcf"
      value="$(find-pkg-share space_satellite_sim)/description/mujoco/scene.xml"
    />
    <arg name="camera" value="scene_camera,servicer_camera,wrist_camera" />
    <arg name="robot_description" value="true" />
    <arg name="topic_namespace" value="" />
  </include>
</launch>

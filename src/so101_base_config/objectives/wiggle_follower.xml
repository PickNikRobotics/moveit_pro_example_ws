<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Wiggle SO101 Follower">
  <BehaviorTree
    ID="Wiggle SO101 Follower"
    _description="Ticks a second so101_arm_bridge instance that always runs in its fake source, regardless of hardware_interface: each joint sweeps about 0.1 rad either side of the pose the arm is measured in when it starts, a joint-by-joint check that every servo is alive and moving the right way. Unlike Mirror SO101 Follower, this stays runnable on real hardware even when the leader is not plugged in."
    _favorite="true"
  >
    <!--
      The bridge only wiggles while these ticks keep arriving, so it stops on
      its own when this Objective is stopped. That is deliberate: the
      trajectory controller has one owner at a time, and a plan and the
      bridge would otherwise fight over it. Stop this Objective before
      pressing Plan.

      Teleoperate's jog modes leave a velocity controller active and
      joint_trajectory_controller inactive; switch back before ticking the
      bridge, or its trajectory points go nowhere.
    -->
    <Control ID="Sequence" name="root">
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_controller"
        deactivate_controllers="joint_velocity_controller;velocity_force_controller"
      />
      <Action
        ID="LogMessage"
        log_level="info"
        message="Wiggling the SO-101 follower. Stop this Objective before planning or executing."
      />
      <Decorator ID="KeepRunningUntilFailure">
        <Control ID="Sequence" name="Keep the bridge wiggling">
          <Action
            ID="CallTriggerService"
            service_name="/so101_arm_bridge_wiggle/mirror"
            response_timeout="3.0"
            wait_for_server_available_timeout="10.0"
          />
          <Action ID="WaitForDuration" delay_duration="0.2" />
        </Control>
      </Decorator>
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Wiggle SO101 Follower">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="SO-101" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

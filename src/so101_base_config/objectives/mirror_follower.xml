<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Mirror SO101 Follower">
  <BehaviorTree
    ID="Mirror SO101 Follower"
    _description="so101_arm_bridge drives joint_trajectory_controller for as long as this Objective runs. On mock and on real hardware in --fake mode, it is the wiggle test: each joint sweeps about 0.1 rad either side of the pose the arm is measured in when it starts, a joint-by-joint check that every servo is alive and moving the right way. On real hardware with the leader connected (--real), it instead mirrors the leader arm's pose onto the follower."
    _favorite="true"
  >
    <!--
      The bridge only mirrors while these ticks keep arriving, so mirroring
      stops on its own when this Objective is stopped. That is deliberate: the
      trajectory controller has one owner at a time, and a plan and the bridge
      would otherwise fight over it. Stop this Objective before pressing Plan.

      Teleoperate's jog modes leave a velocity controller active and
      joint_trajectory_controller inactive; switch back before ticking the
      bridge, or its trajectory points go nowhere.
    -->
    <Control ID="Sequence" name="root">
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_controller"
        deactivate_controllers="joint_velocity_controller;velocity_force_controller"
      />
      <Action
        ID="LogMessage"
        log_level="info"
        message="Mirroring the SO-101 follower. Stop this Objective before planning or executing."
      />
      <Decorator ID="KeepRunningUntilFailure">
        <Control ID="Sequence" name="Keep the bridge mirroring">
          <Action
            ID="CallTriggerService"
            service_name="/so101_arm_bridge/mirror"
            response_timeout="3.0"
            wait_for_server_available_timeout="10.0"
          />
          <Action ID="WaitForDuration" delay_duration="0.2" />
        </Control>
      </Decorator>
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Mirror SO101 Follower">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="SO-101" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

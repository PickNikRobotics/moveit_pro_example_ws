        <mesh filename="package://so101_base_config/description/assets/under_arm_so101_v1.stl"/>
      </geometry>
    </collision>
    <!-- Part motor_holder_so101_wrist_v1 -->
    <visual>
      <origin xyz="-0.0648499 -0.032 0.018" rpy="-3.14159 -2.55351e-15 -1.83387e-30"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/motor_holder_so101_wrist_v1.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="-0.0648499 -0.032 0.018" rpy="-3.14159 -2.55351e-15 -1.83387e-30"/>
      <geometry>

<?xml version="1.0" ?>
<!--
  Stock LeRobot SO-101 follower arm.

  Links, joints, inertials and meshes are the upstream SO-ARM100/LeRobot
  description as vendored by danwahl/vla-test; see description/assets/NOTICE.md.
  Changes made here: mesh paths rewritten to package:// URIs, the ROS 1
  <transmission> blocks dropped, the coacd convex collision decomposition
  collapsed back onto the visual meshes, a `world` link added, and a
  ros2_control block with a mock/real switch appended.
-->
<robot name="so101" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:arg name="hardware_interface" default="mock" />
  <xacro:arg
    name="initial_positions_file"
    default="$(find so101_base_config)/config/initial_positions.yaml"
  />
  <xacro:property
    name="initial_positions"
    value="${xacro.load_yaml('$(arg initial_positions_file)')['initial_positions']}"
  />

  <!--
    Feetech STS3215 bus, used only when hardware_interface:=real.

    `usb_port` is the follower bus; keep it a udev symlink rather than a
    /dev/ttyACM* that renumbers (config/udev/99-so101.rules). The baud rate is
    not an argument: feetech_ros2_driver hardwires 1 Mbaud, which is the SO-101
    factory setting.
  -->
  <xacro:arg name="usb_port" default="/dev/so101_follower" />
  <xacro:arg
    name="calibration_file"
    default="$(find so101_base_config)/config/so101_follower_calibration.yaml"
  />
  <xacro:property
    name="calibration"
    value="${xacro.load_yaml('$(arg calibration_file)')['joints']}"
  />

  <!-- The arm is bolted to the bench; `world` is the planning frame. -->
  <link name="world" />
  <joint name="world_to_so101" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="world" />
    <child link="overhead_camera_mount_link" />
  </joint>


  <!-- Materials -->
  <material name="3d_printed">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="sts3215">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="tpu_fin">
    <color rgba="0.12 0.12 0.13 1.0"/>
  </material>
  
  <!-- Link overhead camera mount --> 
  <link name="overhead_camera_mount_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <!-- Part arm_base -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/arm_base.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/arm_base.stl"/>
      </geometry>
    </collision>
    <!-- Part cam_mount_bottom -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/cam_mount_bottom.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/cam_mount_bottom.stl"/>
      </geometry>
    </collision>
    <!-- Part cam_mount_middle -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/cam_mount_middle.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/cam_mount_middle.stl"/>
      </geometry>
    </collision>
    <!-- Part cam_mount_top -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/cam_mount_top.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/cam_mount_top.stl"/>
      </geometry> 
    </collision>
  </link>

  <!-- Top camera frame (dummy link + fixed joint) -->
  <link name="top_camera_frame_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  
  <joint name="top_camera_frame_fixed_joint" type="fixed">
    <origin xyz="0.033526 0.11597 0.550304 " rpy="-2.70526401 0 -1.5708"/>
    <parent link="overhead_camera_mount_link"/>
    <child link="top_camera_frame_link"/>
    <axis xyz="0 0 0"/>
  </joint>
  
  <!-- Joint from overhead_camera_mount_link to base_link -->
  <joint name="overhead_camera_mount_fixed_joint" type="fixed">
    <origin xyz="0.00636471 9.94414e-05 0.0072" rpy="0 0 0"/>
    <parent link="overhead_camera_mount_link"/>
    <child link="base_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- Link base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0137179 -5.19711e-05 0.0334843" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000114686" ixy="-4.59787e-07" ixz="4.97151e-06" iyy="0.000136117" iyz="9.75275e-08" izz="0.000130364"/>
    </inertial>
    <!-- Part base_motor_holder_so101_v1 -->
    <visual>
      <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/base_motor_holder_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/base_motor_holder_so101_v1.stl"/>
      </geometry>
    </collision>
    <!-- Part base_so101_v2 -->
    <visual>
      <origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/base_so101_v2.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/base_so101_v2.stl"/>
      </geometry>
    </collision>
    <!-- Part sts3215_03a_v1 -->
    <visual>
      <origin xyz="0.0263353 -8.97657e-09 0.0437" rpy="-8.21148e-16 7.84513e-18 1.249e-15"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.0263353 -8.97657e-09 0.0437" rpy="-8.21148e-16 7.84513e-18 1.249e-15"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/sts3215_03a_v1.stl"/>

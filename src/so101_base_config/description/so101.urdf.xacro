    <!-- Part sts3215_03a_v1_2 -->
    <visual>
      <origin xyz="-0.0303992 0.000422241 -0.0417" rpy="1.5708 1.5708 0"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/sts3215_03a_v1.stl"/>

      <geometry>
        <mesh filename="package://so101_base_config/description/assets/sts3215_03a_no_horn_v1.stl"/>
      </geometry>
    </collision>
    <!-- Part wrist_roll_pitch_so101_v2 -->
    <visual>
      <origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0"/>

</link>

  <!-- Link camera wrist mount -->
  <link name="camera_wrist_mount_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <!-- Part camera_wrist_mount -->
    <visual>
      <origin xyz="8.32667e-17 -0.000218214 0.000949706" rpy="-3.14159 -5.55112e-17 0"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/camera_wrist_mount.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="8.32667e-17 -0.000218214 0.000949706" rpy="-3.14159 -5.55112e-17 0"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/camera_wrist_mount.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint from gripper to camera wrist mount -->
  <joint name="camera_wrist_mount_fixed_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_link"/>
    <child link="camera_wrist_mount_link"/>
    <axis xyz="0 0 0"/>
  </joint>
  
  <!-- Wrist camera frame (dummy link + fixed joint) -->
  <link name="wrist_camera_frame_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  
  <joint name="wrist_camera_frame_fixed_joint" type="fixed">
    <origin xyz="0.0025 0.072010214 -0.000859294" rpy="2.704208 -0.067216 0.031395"/>
    <parent link="camera_wrist_mount_link"/>
    <child link="wrist_camera_frame_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- Gripper frame (dummy link + fixed joint) -->
  <link name="gripper_frame_link">
    <origin xyz="0 0 0" rpy="0 -0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="gripper_frame_joint" type="fixed">
    <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0"/>
    <parent link="gripper_link"/>
    <child link="gripper_frame_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- Link moving_jaw_so101_v1 -->
  <link name="moving_jaw_so101_v1_link">
    <inertial>
      <origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06" iyz="-1.09945e-07" izz="5.28738e-06"/>
    </inertial>
    <!-- Part soft_fin_moving_jaw: the XLeRobot fin-gripper replacement for
         moving_jaw_so101_v1. Same pivot yoke and mesh frame as the stock part,
         so this keeps the stock part's origin; the moulded blade is gone,
         replaced by the fork below. -->
    <visual>
      <origin xyz="-5.55112e-17 -5.55112e-17 0.0189" rpy="9.53145e-17 6.93889e-18 1.24077e-24"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/soft_fin_moving_jaw.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="-5.55112e-17 -5.55112e-17 0.0189" rpy="9.53145e-17 6.93889e-18 1.24077e-24"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/soft_fin_moving_jaw_collision.stl"/>
      </geometry>
    </collision>
    <!-- Part soft_fin_finger, moving side: the moving jaw's two-bore frame. -->
    <visual>
      <origin xyz="-0.00115 -0.0222 0.0181" rpy="1.5708 -1.07812e-17 3.10121"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/soft_fin_finger.stl"/>
      </geometry>
      <material name="tpu_fin"><color rgba="0.12 0.12 0.13 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="-0.00115 -0.0222 0.0181" rpy="1.5708 -1.07812e-17 3.10121"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/soft_fin_finger.stl"/>
      </geometry>
    </collision>
</link>

  <!-- Joint from gripper to moving_jaw_so101_v1 -->
  <joint name="gripper" type="revolute">
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-08 -1.41553e-15"/>
    <parent link="gripper_link"/>
    <child link="moving_jaw_so101_v1_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
  </joint>


  <!-- Joint from wrist to gripper -->
  <joint name="wrist_roll" type="revolute">
    <origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 1.6194795 3.14159"/>
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121"/>
  </joint>


  <!-- Joint from lower_arm to wrist -->
  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 3.62355e-17" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.65806" upper="1.65806"/>
  </joint>


  <!-- Joint from upper_arm to lower_arm -->
  <!-- Note: 5-degree calibration offset applied to joint limits -->
  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 1.73763e-16" rpy="-3.63608e-16 8.74301e-16 1.5708"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.69" upper="1.69"/>
  </joint>


  <!-- Joint from shoulder to upper_arm -->
  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.74533" upper="1.74533"/>
  </joint>


  <!-- Joint from base to shoulder -->
  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0388353 -8.97657e-09 0.0624" rpy="3.14159 4.18253e-17 -3.14159"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986"/>
  </joint>

  <xacro:macro name="so101_joint" params="name lower upper">
    <joint name="${name}">
      <!--
        Servo identity and zero, from config/so101_follower_calibration.yaml.
        The driver reads `id` to address the servo and treats `offset` as the
        raw tick that means 0 rad. Absent on mock, where they mean nothing.
      -->
      <xacro:if value="${'$(arg hardware_interface)' == 'real'}">
        <param name="id">${calibration[name]['id']}</param>
        <param name="offset">${calibration[name]['offset']}</param>
        <!--
          Optional PID gains, EEPROM-written by the driver at every on_init
          when present (feetech_ros2_driver.cpp, ~line 58). Absent when the
          calibration entry does not carry them, leaving the servo's stored
          value alone - see config/so101_follower_calibration.yaml.
        -->
        <xacro:if value="${'p_cofficient' in calibration[name]}">
          <param name="p_cofficient">${calibration[name]['p_cofficient']}</param>
        </xacro:if>
        <xacro:if value="${'i_cofficient' in calibration[name]}">
          <param name="i_cofficient">${calibration[name]['i_cofficient']}</param>
        </xacro:if>
        <xacro:if value="${'d_cofficient' in calibration[name]}">
          <param name="d_cofficient">${calibration[name]['d_cofficient']}</param>
        </xacro:if>
      </xacro:if>
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions[name]}</param>
      </state_interface>
      <state_interface name="velocity" />
      <!--
        Mock only. feetech_ros2_driver overrides export_state_interfaces() and
        exports position and velocity alone, and ros2_control's
        validate_storage() rejects a hardware component whose URDF declares a
        state interface it did not export ("Discrepancy between robot
        description file (urdf) and actually exported HW interfaces"). An
        effort declaration on the real branch is therefore fatal at load, not
        inert; that is also why joint_state_broadcaster does not ask for one.
      -->
      <xacro:if value="${'$(arg hardware_interface)' == 'mock'}">
        <state_interface name="effort" />
      </xacro:if>
    </joint>
  </xacro:macro>

  <ros2_control name="so101" type="system">
    <xacro:if value="${'$(arg hardware_interface)' == 'mock'}">
      <hardware>
        <!-- Echoes command to state. The twin's joint values arrive over the
             joint_trajectory_controller topic, not from a serial port. -->
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
    </xacro:if>
    <xacro:if value="${'$(arg hardware_interface)' == 'real'}">
      <hardware>
        <!--
          One serial bus, six STS3215 servos daisy-chained, position command
          and position/velocity feedback. The plugin is the workspace's
          vendored feetech_ros2_driver (src/external_dependencies), upstream
          0.2.2 plus a torque lifecycle: off at configure, on at activate for
          the joints with a command interface, off at deactivate.
        -->
        <plugin>feetech_ros2_driver/FeetechHardwareInterface</plugin>
        <param name="usb_port">$(arg usb_port)</param>
      </hardware>
    </xacro:if>
    <!-- Limits are the upstream LeRobot calibration, in radians. -->
    <xacro:so101_joint name="shoulder_pan" lower="-1.91986" upper="1.91986" />
    <xacro:so101_joint name="shoulder_lift" lower="-1.74533" upper="1.74533" />
    <xacro:so101_joint name="elbow_flex" lower="-1.69" upper="1.69" />
    <xacro:so101_joint name="wrist_flex" lower="-1.65806" upper="1.65806" />
    <xacro:so101_joint name="wrist_roll" lower="-2.74385" upper="2.84121" />
    <xacro:so101_joint name="gripper" lower="-0.174533" upper="1.74533" />
  </ros2_control>
</robot>

    </collision>
    <!-- Part upper_arm_so101_v1 -->
    <visual>
      <origin xyz="-0.065085 0.012 0.0182" rpy="3.14159 -0 -1.30911e-30"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/upper_arm_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="-0.065085 0.012 0.0182" rpy="3.14159 -0 -1.30911e-30"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/upper_arm_so101_v1.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link lower_arm -->
  <link name="lower_arm_link">
    <inertial>
      <origin xyz="-0.0980701 0.00324376 0.0182831" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="2.87438e-05" ixy="7.41152e-06" ixz="1.26409e-06" iyy="0.000159844" iyz="-4.90188e-08" izz="0.00014529"/>
    </inertial>
    <!-- Part under_arm_so101_v1 -->
    <visual>
      <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 -0 6.67202e-31"/>
      <geometry>
        <mesh filename="package://so101_base_config/description/assets/under_arm_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 -0 6.67202e-31"/>

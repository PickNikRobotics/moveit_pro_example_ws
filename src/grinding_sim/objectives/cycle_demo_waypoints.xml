<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Cycle Demo Waypoints">
  <!--//////////-->
  <BehaviorTree
    ID="Cycle Demo Waypoints"
    _description="Continuously cycle the arm through the Right, Left, Upper Left, and Upper Right waypoints, sweeping the tool camera over the engine block. Runs until cancelled."
    _favorite="true"
  >
    <Decorator ID="Repeat" num_cycles="-1">
      <Control ID="Sequence">
        <SubTree ID="Move to Waypoint" _collapsed="true" waypoint_name="Right" />
        <SubTree ID="Move to Waypoint" _collapsed="true" waypoint_name="Left" />
        <SubTree
          ID="Move to Waypoint"
          _collapsed="true"
          waypoint_name="Upper Left"
        />
        <SubTree
          ID="Move to Waypoint"
          _collapsed="true"
          waypoint_name="Upper Right"
        />
      </Control>
    </Decorator>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Cycle Demo Waypoints">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Motion - Execute" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

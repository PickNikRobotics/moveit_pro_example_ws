<?xml version='1.0' encoding='UTF-8'?>
<!-- Derived from Seeed reBot-DevArm; CERN-OHL-W-2.0. Modified by PickNik Inc., 2026-10-10: visual replacements and mock hardware selector. See NOTICE.md. Original SolidWorks exporter: Stephen Brawner (brawner@gmail.com), 1.6.0-4-g7f85cfe, build 1.6.7995.38578; http://wiki.ros.org/sw_urdf_exporter. -->
<robot name="rebot_b601_rs" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="hardware_interface" default="mock" />
  <!-- Real hardware only; ignored by mock. The bench runs one 1 Mbps bus. -->
  <xacro:arg name="can_interface" default="can0" />
  <!-- false brings the arm up readable but limp: state is published and the
       joints can be moved by hand, nothing is commanded. The first session on
       real hardware uses this. -->
  <xacro:arg name="torque_enable" default="true" />
  <!-- Real hardware only; joint1-joint6 control mode. "motion" is impedance
       (MIT): torque = kp * error + kd * velocity error + effort. effort is 0
       unless gravity_compensation_controller is active, and without it a
       loaded joint settles short by load torque / kp.
       "position_csp" is the motor's own position loop, which settles on
       target and is capped by the motor's stored speed limit (0x7017). The
       gripper always uses motion. Unsupported values fail expansion. -->
  <xacro:arg name="arm_control_mode" default="motion" />
  <!-- Unsupported selectors fail expansion. -->
  <xacro:property name="hardware_plugins" value="${dict(mock='mock_components/GenericSystem', real='robstride_hardware_interface/RobstrideHardware')}" />

  <TreeNodesModel>
    <SubTree ID="Collect reBot Gravity Data">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="reBot Gravity Identification" />
      </MetadataFields>
      <input_port
        name="dataset_name"
        default="rebot_gravity_raw"
        type="std::string"
      >
        New recording dataset. Keep the raw MCAP, not a converted training
        dataset.
      </input_port>
      <input_port
        name="training_config"
        default="rebot_bench_jpeg"
        type="std::string"
      >
        Existing Trainer config for joint states, controller state and camera
        streams.
      </input_port>
      <input_port name="settle_seconds" default="1.5" type="double">
        Settling wait after reaching each waypoint, seconds.
      </input_port>
      <input_port name="sample_seconds" default="2.1" type="double">
        Additional static recording time, seconds; two one-second extraction
        attempts.
      </input_port>
    </SubTree>
  </TreeNodesModel>

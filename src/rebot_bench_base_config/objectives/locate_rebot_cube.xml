<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Locate reBot Cube">
  <BehaviorTree
    ID="Locate reBot Cube"
    _description="Segment one cube with SAM3 and measure its top face in the printed world frame."
  >
    <Sequence>
      <Action
        ID="GetImage"
        topic_name="{image_topic}"
        message_out="{image}"
        message_timeout_sec="5"
        publisher_timeout_sec="5"
      />
      <Action
        ID="GetCameraInfo"
        topic_name="{camera_info_topic}"
        message_out="{camera_info}"
        message_timeout_sec="5"
        publisher_timeout_sec="5"
      />
      <Action
        ID="GetMasks2DFromExemplar"
        target_image="{image}"
        text_prompt="{prompt}"
        confidence_threshold="0.2"
        confidence_scores_str="{confidence_scores}"
        model_package="moveit_pro_sam3"
        model_bundle_manifest="models/model.yaml"
        masks2d="{masks2d}"
        mask_count="{mask_count}"
      />
      <Action
        ID="PublishMask2D"
        image="{image}"
        masks="{masks2d}"
        masks_visualization_topic="{mask_topic}"
        bounding_box_detection_class="{prompt}"
      />
      <Action
        ID="FitCubeToMask"
        masks2d="{masks2d}"
        camera_info="{camera_info}"
        cube_top="{cube_top}"
        silhouette_rms_px="{silhouette_rms_px}"
      />
      <Action
        ID="TransformPose"
        input_pose="{cube_top}"
        output_pose="{cube_top}"
        visualize_pose="true"
        marker_text="{prompt}"
        marker_size="0.05"
      />
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Locate reBot Cube">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="reBot Bench" />
      </MetadataFields>
      <input_port name="prompt" type="std::string">
        Cube description, such as blue cube or red cube.
      </input_port>
      <input_port
        name="image_topic"
        default="/scene_camera/color/image_raw"
        type="std::string"
      />
      <input_port
        name="camera_info_topic"
        default="/scene_camera/color/camera_info"
        type="std::string"
      />
      <input_port
        name="mask_topic"
        default="/rebot/cube_masks"
        type="std::string"
      />
      <output_port name="cube_top" type="geometry_msgs::msg::PoseStamped">
        Fitted top-face centre in world on z=0.05; orientation is the cube yaw
        modulo 90 degrees.
      </output_port>
    </SubTree>
  </TreeNodesModel>
</root>

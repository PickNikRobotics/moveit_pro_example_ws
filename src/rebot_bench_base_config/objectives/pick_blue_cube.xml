<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Pick Blue Cube">
  <BehaviorTree
    ID="Pick Blue Cube"
    _description="Locate both cubes with SAM3 and calibrated RGB and check the pick and place for reach before any motion, then open the jaw at home, confirm it opened, and pick the blue 50 mm cube. Leaves it attached and held above its starting position. Speeds come from objectives/rebot_stack_motion.yaml."
  >
    <Sequence>
      <SubTree
        ID="reBot Stack Motion"
        joint_velocity_scale_factor="{joint_velocity_scale_factor}"
        joint_acceleration_scale_factor="{joint_acceleration_scale_factor}"
        cartesian_velocity_scale_factor="{cartesian_velocity_scale_factor}"
        cartesian_acceleration_scale_factor="{cartesian_acceleration_scale_factor}"
        gripper_velocity_scale_factor="{gripper_velocity_scale_factor}"
        gripper_acceleration_scale_factor="{gripper_acceleration_scale_factor}"
      />
      <SubTree
        ID="Locate reBot Cubes"
        blue_top="{blue_top}"
        red_top="{red_top}"
      />
      <SubTree
        ID="reBot Stack Scene"
        blue_top="{blue_top}"
        red_top="{red_top}"
      />
      <SubTree
        ID="reBot Check Stack Reach"
        blue_top="{blue_top}"
        red_top="{red_top}"
        pick_hover="{pick_hover}"
        pick="{pick}"
        place="{place}"
      />
      <Script code="motion_started := true" />
      <!-- Close the jaw first, planned natively from measured state, so the
           commanded home below holds for the jaw too. Anchor to the commanded
           home rather than the measured rest, since a sagged joint can measure
           past its limit and the planners refuse it. AnchorTrajectoryToCommand
           still falls back to measurement if a joint is more than 0.10 rad
           from it. -->
      <SubTree ID="Close Gripper" />
      <Action
        ID="CreateRobotState"
        joint_names="joint1;joint2;joint3;joint4;joint5;joint6;joint7"
        positions="0;0;0;0;0;0;0"
        joint_state_msg="{commanded_state}"
      />
      <SubTree
        ID="reBot Open Jaw"
        gripper_velocity_scale_factor="{gripper_velocity_scale_factor}"
        gripper_acceleration_scale_factor="{gripper_acceleration_scale_factor}"
        commanded_state="{commanded_state}"
      />
      <SubTree
        ID="reBot Move to Arm Waypoint"
        waypoint_name="Pick and Stack Survey"
        velocity_scale_factor="{joint_velocity_scale_factor}"
        acceleration_scale_factor="{joint_acceleration_scale_factor}"
        commanded_state="{commanded_state}"
      />
      <SubTree
        ID="Move reBot Gripper"
        waypoint_name="Stack Gripper Open"
        velocity_scale_factor="{gripper_velocity_scale_factor}"
        acceleration_scale_factor="{gripper_acceleration_scale_factor}"
        commanded_state="{commanded_state}"
      />
      <SubTree
        ID="reBot Move to Pose"
        target="{pick_hover}"
        gripper_position="5.25"
        velocity_scale_factor="{joint_velocity_scale_factor}"
        acceleration_scale_factor="{joint_acceleration_scale_factor}"
        commanded_state="{commanded_state}"
      />
      <SubTree
        ID="reBot Move Straight"
        target="{pick}"
        gripper_position="5.25"
        velocity_scale_factor="{cartesian_velocity_scale_factor}"
        acceleration_scale_factor="{cartesian_acceleration_scale_factor}"
        commanded_state="{commanded_state}"
      />
      <Script code="holding := true" />
      <SubTree
        ID="Move reBot Gripper"
        waypoint_name="Stack Gripper Hold"
        velocity_scale_factor="{gripper_velocity_scale_factor}"
        acceleration_scale_factor="{gripper_acceleration_scale_factor}"
        commanded_state="{commanded_state}"
      />
      <Action
        ID="SetCollisionRule"
        name_a="rebot_blue"
        name_b="rebot_bench"
        allow_collision="true"
      />
      <Action
        ID="AttachObject"
        object_id="rebot_blue"
        link_name="gripper_end"
        allowed_collision_links="gripper_left;gripper_right;gripper_end"
      />
      <SubTree
        ID="reBot Move Straight"
        target="{pick_hover}"
        gripper_position="2.8125"
        velocity_scale_factor="{cartesian_velocity_scale_factor}"
        acceleration_scale_factor="{cartesian_acceleration_scale_factor}"
        commanded_state="{commanded_state}"
      />
      <Action
        ID="SetCollisionRule"
        name_a="rebot_blue"
        name_b="rebot_bench"
        allow_collision="false"
      />
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Pick Blue Cube">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="reBot Bench" />
      </MetadataFields>
      <output_port name="red_top" type="geometry_msgs::msg::PoseStamped" />
      <output_port
        name="place"
        default="{place}"
        type="geometry_msgs::msg::PoseStamped"
      >
        Where the held cube is released on red.
      </output_port>
      <output_port name="holding" default="{holding}" type="bool">
        True from just before the grasp closes: the jaw may be around the blue
        cube.
      </output_port>
      <output_port name="motion_started" default="{motion_started}" type="bool">
        True once the reach check has passed and the first motion is sent.
      </output_port>
      <inout_port
        name="commanded_state"
        default="{commanded_state}"
        type="moveit_msgs::msg::RobotState"
      >
        The controller's command for all seven joints after the last leg.
      </inout_port>
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="reBot Plan Place">
  <BehaviorTree
    ID="reBot Plan Place"
    _description="Choose a reachable place hover above a support surface and the release pose that rests the held cube on it. No motion is executed."
  >
    <Sequence>
      <SubTree
        ID="reBot Select Place Hover"
        red_top="{support_top}"
        place_hover="{place_hover}"
      />
      <!-- The cube centre is 10 mm along tool +X from the fingertips after the 35 mm pick.
           At 5 degrees release tilt, compensate that offset in support_top axes;
           place the tilted cube bottom on the support before opening, without a drop. -->
      <Action
        ID="TransformPose"
        input_pose="{support_top}"
        translation_xyz="-0.000871557;0;0.037045702"
        quaternion_xyzw="0;0.6755902076156602;0;0.7372773368101241"
        output_pose="{place}"
      />
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="reBot Plan Place">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="reBot Bench" />
      </MetadataFields>
      <input_port name="support_top" type="geometry_msgs::msg::PoseStamped">
        Centre of the surface the held cube is set down on, in world: red's
        measured top face, or a spot on the mat at z=0. Its yaw sets the
        released cube's yaw.
      </input_port>
      <output_port name="place_hover" type="geometry_msgs::msg::PoseStamped" />
      <output_port name="place" type="geometry_msgs::msg::PoseStamped" />
    </SubTree>
  </TreeNodesModel>
</root>

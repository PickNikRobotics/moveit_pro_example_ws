<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Recover Cube from Wall">
  <BehaviorTree
    ID="Recover Cube from Wall"
    _description="Pull a cube that sits too close to the foam wall to be picked from above back into the proven stacking area: grasp it from the robot side with a low, tilted approach, carry it over the other cube to the target, set it down, and return home with the jaw closed. Every pose is reach-checked before the arm moves; a step that fails after that still ends home. Speeds come from objectives/rebot_stack_motion.yaml."
  >
    <Sequence>
      <SubTree
        ID="reBot Stack Motion"
        joint_velocity_scale_factor="{joint_velocity_scale_factor}"
        joint_acceleration_scale_factor="{joint_acceleration_scale_factor}"
        cartesian_velocity_scale_factor="{cartesian_velocity_scale_factor}"
        cartesian_acceleration_scale_factor="{cartesian_acceleration_scale_factor}"
        gripper_velocity_scale_factor="{gripper_velocity_scale_factor}"
        gripper_acceleration_scale_factor="{gripper_acceleration_scale_factor}"
      />
      <!-- The cube carried takes the scene name rebot_blue whatever its colour;
           the other cube is the rebot_red obstacle. -->
      <!-- Blue stacked on red is located as the unstack locates it: red's top
           face is hidden, so red sits directly under blue. -->
      <Fallback>
        <Sequence>
          <ScriptCondition code="stacked == true" />
          <Script code="effective_support := 'rebot_red'" />
          <Script code="carried_name := 'blue cube'" />
          <SubTree
            ID="Prepare reBot Unstack"
            blue_top="{cube_top}"
            red_top="{other_top}"
          />
        </Sequence>
        <Sequence>
          <ScriptCondition code="stacked == false" />
          <Script code="effective_support := support_object" />
          <Script code="carried_name := prompt" />
          <SubTree
            ID="Locate reBot Cube"
            prompt="{prompt}"
            mask_topic="/rebot/cube_masks"
            cube_top="{cube_top}"
          />
          <SubTree
            ID="Locate reBot Cube"
            prompt="{other_prompt}"
            mask_topic="/rebot/cube_masks"
            cube_top="{other_top}"
          />
          <SubTree
            ID="reBot Stack Scene"
            blue_top="{cube_top}"
            red_top="{other_top}"
          />
        </Sequence>
      </Fallback>
      <!-- Target: the centre of the proven stacking area, away from the wall,
           its x axis pointing away from the base like a located cube. -->
      <Action
        ID="CreatePoseStamped"
        reference_frame="world"
        position_xyz="{target_xyz}"
        orientation_xyzw="{target_xyzw}"
        pose_stamped="{target_top}"
      />
      <Action ID="GetCurrentPlanningScene" planning_scene_msg="{scene}" />
      <!-- No motion until one approach has every pose in reach. The cube is
           approached along its +x axis, which the located yaw keeps within 45
           degrees of the base's: from the robot side, so the arm stays off the
           wall. A cube by the wall takes a lower wrist than a pick from above. -->
      <Fallback>
        <!-- Tool tilted 20 degrees down. -->
        <Sequence>
          <Action
            ID="TransformPose"
            input_pose="{cube_top}"
            translation_xyz="-0.0845723;0;0.00578181"
            quaternion_xyzw="0;0.173648;0;0.984808"
            output_pose="{pregrasp}"
          />
          <Action ID="ResetVector" vector="{path}" />
          <Action
            ID="PushBackVector"
            input_vector="{path}"
            element="{pregrasp}"
            output_vector="{path}"
          />
          <Action
            ID="ComputeInverseKinematics"
            target_poses="{path}"
            tip_links="gripper_end"
            planning_scene_msg="{scene}"
            planning_group_name="manipulator"
            ik_timeout_s="0.5"
            solve_mode="optimize_distance"
            optimization_timeout_s="0.1"
            link_padding="0.0"
            solution="{goal}"
          />
          <Action

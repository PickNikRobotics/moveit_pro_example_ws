  <TreeNodesModel>
    <SubTree ID="Recover Cube from Wall">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="reBot Bench" />
      </MetadataFields>
      <input_port name="prompt" default="red cube" type="std::string">
        The cube to pull back from the wall.
      </input_port>
      <input_port name="other_prompt" default="blue cube" type="std::string">
        The other cube, an obstacle on the way.
      </input_port>
      <input_port name="target_xyz" default="0.37;0.14;0.05" type="std::string">
        Top-face centre to set the cube down at, world metres.
      </input_port>
      <input_port name="stacked" default="false" type="bool">
        True for blue stacked on red: blue is located on red and red under
        it; prompt and other_prompt are not used. The grasp automatically uses
        rebot_red as its collision support, ignoring support_object.
      </input_port>
      <input_port
        name="support_object"
        default="rebot_bench"
        type="std::string"
      >
        Collision object the cube rests on, which it may touch while grasped and
        lifted when stacked=false. Stacked mode selects rebot_red automatically.
      </input_port>
      <input_port
        name="target_xyzw"
        default="0;0;0.9872;0.1593"
        type="std::string"
      >
        The target's orientation: its x axis points away from the base (world
        0.726, 0.022), as a located cube's does, so the robot-side approach
        reaches it. Change it with target_xyz.
      </input_port>
    </SubTree>
  </TreeNodesModel>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Prepare reBot Stack">
  <BehaviorTree
    ID="Prepare reBot Stack"
    _description="Locate cubes, add their collision geometry, and open the gripper before a bench pick."
  >
    <Sequence>
      <SubTree
        ID="reBot Stack Motion"
        joint_velocity_scale_factor="{joint_velocity_scale_factor}"
        joint_acceleration_scale_factor="{joint_acceleration_scale_factor}"
        cartesian_velocity_scale_factor="{cartesian_velocity_scale_factor}"
        cartesian_acceleration_scale_factor="{cartesian_acceleration_scale_factor}"
        gripper_velocity_scale_factor="{gripper_velocity_scale_factor}"
        gripper_acceleration_scale_factor="{gripper_acceleration_scale_factor}"
      />
      <SubTree
        ID="Locate reBot Cubes"
        blue_top="{blue_top}"
        red_top="{red_top}"
      />
      <SubTree
        ID="reBot Stack Scene"
        blue_top="{blue_top}"
        red_top="{red_top}"
      />
      <SubTree
        ID="reBot Open Jaw"
        gripper_velocity_scale_factor="{gripper_velocity_scale_factor}"
        gripper_acceleration_scale_factor="{gripper_acceleration_scale_factor}"
      />
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Prepare reBot Stack">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="reBot Bench" />
      </MetadataFields>
      <output_port name="blue_top" type="geometry_msgs::msg::PoseStamped" />
      <output_port name="red_top" type="geometry_msgs::msg::PoseStamped" />
    </SubTree>
  </TreeNodesModel>
</root>

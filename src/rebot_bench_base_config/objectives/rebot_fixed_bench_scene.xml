<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="reBot Fixed Bench Scene">
  <BehaviorTree ID="reBot Fixed Bench Scene" _description="Add the fixed mat/table and foam wall used by the stack tasks. No cubes, detachments, or blanket scene clearing.">
    <Sequence>
      <Action ID="CreatePoseStamped" reference_frame="world" position_xyz="0.133;0.16;-0.0515" pose_stamped="{mat_pose}" />
      <Action ID="AddCollisionBox" object_id="rebot_bench" dimensions="0.9144;0.4;0.103" pose="{mat_pose}" overwrite="true" />
      <!-- The wall box stands 5 mm proud of the real face at y=0.36. -->
      <Action ID="CreatePoseStamped" reference_frame="world" position_xyz="0.15;0.3675;0.3" pose_stamped="{wall_pose}" />
      <Action ID="AddCollisionBox" object_id="rebot_wall" dimensions="1.0;0.025;0.6" pose="{wall_pose}" overwrite="true" />
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="reBot Fixed Bench Scene">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="reBot Bench" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

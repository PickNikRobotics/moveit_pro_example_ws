<?xml version='1.0' encoding='UTF-8'?>
<robot name="rebot_b601_rs">
  <group name="manipulator">
    <chain base_link="base_link" tip_link="gripper_end" />
  </group>
  <group name="gripper">
    <joint name="joint7" />
    <joint name="gripper_joint1" />
    <joint name="gripper_joint2" />
  </group>
  <end_effector name="rebot_gripper" parent_link="gripper_end" parent_group="manipulator" group="gripper" />
  <group_state name="zeroed_rest" group="manipulator">
    <joint name="joint1" value="0" />
    <joint name="joint2" value="0" />
    <joint name="joint3" value="0" />
    <joint name="joint4" value="0" />
    <joint name="joint5" value="0" />
    <joint name="joint6" value="0" />
  </group_state>
  <group_state name="raised" group="manipulator">
    <joint name="joint1" value="0" />
    <joint name="joint2" value="0.65" />
    <joint name="joint3" value="0.85" />
    <joint name="joint4" value="0.3" />
    <joint name="joint5" value="0" />
    <joint name="joint6" value="0" />
  </group_state>
  <group_state name="gripper_closed" group="gripper">
    <joint name="joint7" value="0" />
  </group_state>
  <group_state name="gripper_open" group="gripper">
    <joint name="joint7" value="5.410520681182422" />
  </group_state>
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent" />
  <disable_collisions link1="link1" link2="link2" reason="Adjacent" />
  <disable_collisions link1="link2" link2="link3" reason="Adjacent" />
  <disable_collisions link1="link3" link2="link4" reason="Adjacent" />
  <disable_collisions link1="link4" link2="link5" reason="Adjacent" />
  <disable_collisions link1="link5" link2="link6" reason="Adjacent" />
  <disable_collisions link1="link6" link2="gripper_end" reason="Adjacent" />
  <!-- gripper_end is fixed to link6: adjacent across J6. Meshes have a
       rotation-invariant 9.0 mm axial gap, smaller than default 10 mm padding. -->
  <disable_collisions link1="link5" link2="gripper_end" reason="Adjacent" />
  <disable_collisions link1="gripper_end" link2="gripper_left" reason="Adjacent" />
  <disable_collisions link1="gripper_end" link2="gripper_right" reason="Adjacent" />
  <disable_collisions link1="gripper_end" link2="gripper_motor_frame" reason="Adjacent" />
  <!-- Opposing, mechanically coupled jaws meet at closure and separate on opening. -->
  <disable_collisions link1="gripper_left" link2="gripper_right" reason="Default" />
</robot>

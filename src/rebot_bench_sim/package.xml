<?xml version="1.0" ?>
<package format="3">
  <name>rebot_bench_sim</name>
  <version>10.3.0</version>

  <description>
    MuJoCo twin of the reBot bench: the reBot arm, both cameras, the mat, the
    wall and two cubes, placed from one bench layout file.
  </description>

  <maintainer email="support@picknik.ai">MoveIt Pro Maintainer</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Generate description/scene.xml, rebot_arm.xml and the layout snapshot
       from config/bench_layout.yaml (scripts/layout_snapshot.py). -->
  <buildtool_depend>xacro</buildtool_depend>
  <build_depend>python3-yaml</build_depend>

  <depend>rebot_bench_base_config</depend>
  <exec_depend>moveit_pro_objectives</exec_depend>
  <exec_depend>moveit_studio_agent</exec_depend>
  <exec_depend>mujoco_package_uri</exec_depend>
  <exec_depend>picknik_mujoco_ros</exec_depend>
  <exec_depend>picknik_nyx_renderer</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>moveit_studio_internal_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>moveit_pro_test_utils</test_depend>
  <test_depend>moveit_studio_utils_py</test_depend>
  <test_depend>picknik_ament_copyright</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>moveit_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

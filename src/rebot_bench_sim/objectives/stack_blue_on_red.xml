<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Stack Blue on Red">
  <BehaviorTree
    ID="Stack Blue on Red"
    _description="Locate two 50 mm cubes with SAM3, pick blue, place it on red, and return home with the jaw closed. Requires calibrated world and RGB camera frames. Speeds come from objectives/rebot_stack_motion.yaml."
  >
    <Sequence>
      <SubTree
        ID="reBot Stack Motion"
        joint_velocity_scale_factor="{joint_velocity_scale_factor}"
        joint_acceleration_scale_factor="{joint_acceleration_scale_factor}"
        cartesian_velocity_scale_factor="{cartesian_velocity_scale_factor}"
        cartesian_acceleration_scale_factor="{cartesian_acceleration_scale_factor}"
        gripper_velocity_scale_factor="{gripper_velocity_scale_factor}"
        gripper_acceleration_scale_factor="{gripper_acceleration_scale_factor}"
      />
      <Script code="holding := false; motion_started := false" />
      <Fallback>
        <Sequence>
          <SubTree
            ID="Pick Blue Cube"
            red_top="{red_top}"
            place="{place}"
            holding="{holding}"
            motion_started="{motion_started}"
            commanded_state="{commanded_state}"
          />
          <SubTree
            ID="reBot Place Blue"
            support_top="{red_top}"
            support_object="rebot_red"
            holding="{holding}"
            joint_velocity_scale_factor="{joint_velocity_scale_factor}"
            joint_acceleration_scale_factor="{joint_acceleration_scale_factor}"
            cartesian_velocity_scale_factor="{cartesian_velocity_scale_factor}"
            cartesian_acceleration_scale_factor="{cartesian_acceleration_scale_factor}"
            gripper_velocity_scale_factor="{gripper_velocity_scale_factor}"
            gripper_acceleration_scale_factor="{gripper_acceleration_scale_factor}"
            commanded_state="{commanded_state}"
          />
          <!-- The arm is home; close the empty jaw so all seven joints end at home.
               The native Close Gripper plans to the closed limit itself; a
               point-to-point trajectory ending exactly on joint7's 0 rad bound can
               undershoot it numerically and be refused. -->
          <SubTree ID="Close Gripper" />
        </Sequence>
        <!-- Any failed leg, an IK failure included, ends home rather than
             wherever the arm stopped. The Objective still fails. -->
        <Sequence _skipIf="!motion_started">
          <SubTree
            ID="reBot Recover Home"
            holding="{holding}"
            velocity_scale_factor="{joint_velocity_scale_factor}"
            acceleration_scale_factor="{joint_acceleration_scale_factor}"
            commanded_state="{commanded_state}"
          />
          <AlwaysFailure />
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Stack Blue on Red">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="reBot Bench" />
      </MetadataFields>
      <output_port
        name="red_top"
        default="{red_top}"
        type="geometry_msgs::msg::PoseStamped"
      >
        Red's top face as located before any motion.
      </output_port>
    </SubTree>
  </TreeNodesModel>
</root>

      name="rs_anodized_silver"
      rgba="0.720 0.760 0.730 1"
      specular="0.5"
    />
    <material name="d435_grey" rgba="0.15 0.15 0.16 1" />
    <!-- The printed parts' embedded COLLADA colours, sRGB (91, 44, 143) and
         (242, 242, 242). -->
    <material name="print_purple" rgba="0.357 0.173 0.561 1" />
    <material name="print_white" rgba="0.949 0.949 0.949 1" />

    <mesh

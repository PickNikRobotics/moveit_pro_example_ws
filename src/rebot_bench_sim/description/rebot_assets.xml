      name="d435"
      file="package://rebot_bench_sim/description/assets/realsense/d435.stl"
    />
  </asset>

  <default>
    <default class="rebot">
      <!-- Visual geoms render but never collide and carry no mass: the
           URDF inertials are the whole model, as in the base description. -->
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" density="0" />
      </default>
      <!-- Robot collision geoms touch the scene (contype 1 objects) but not
           each other: the folded rest pose sits within millimetres of itself,
           closer than MuJoCo's convex hulls allow. -->
      <default class="collision">
        <geom type="mesh" contype="2" conaffinity="1" group="3" />
      </default>
      <default class="rs06">
        <joint armature="0.05" damping="1" />
        <position forcerange="-36 36" />
      </default>
      <default class="rs00">
        <joint armature="0.01" damping="0.2" />
        <position forcerange="-14 14" />
      </default>
      <default class="gripper_motor">
        <joint armature="0.002" damping="0.02" />
        <position forcerange="-14 14" />
      </default>
      <default class="jaw">
        <joint
          type="slide"
          axis="0 0 1"
          range="0 0.04328416544945937"
          damping="0.5"
        />
      </default>
    </default>
  </default>

  <actuator>
    <position
      name="joint1"
      joint="joint1"
      class="rs06"
      kp="50"
      kv="3"
      ctrlrange="-2.530727415392 2.530727415392"
    />
    <position
      name="joint2"
      joint="joint2"
      class="rs06"
      kp="150"
      kv="10"
      ctrlrange="0 3.543018381548"
    />
    <position
      name="joint3"
      joint="joint3"
      class="rs06"
      kp="150"
      kv="10"
      ctrlrange="0 4.171336912266"
    />
    <position
      name="joint4"
      joint="joint4"
      class="rs00"
      kp="50"
      kv="5"
      ctrlrange="-1.850049007114 1.500983156715"
    />
    <position
      name="joint5"
      joint="joint5"
      class="rs00"
      kp="50"
      kv="4"
      ctrlrange="-1.762782544514 1.884955592154"
    />
    <position
      name="joint6"
      joint="joint6"
      class="rs00"
      kp="50"
      kv="4"
      ctrlrange="-3.054326190990 3.054326190990"
    />
    <position
      name="joint7"
      joint="joint7"
      class="gripper_motor"
      kp="12"
      kv="0.05"
      ctrlrange="0 5.410520681182422"
    />
  </actuator>

  <equality>
    <!-- SIM-ONLY grasp proxy: disabled until closing jaws contact blue. -->
    <weld
      name="sim_grasp_proxy_blue"
      body1="gripper_left"
      body2="blue_cube"
      active="false"
    />
    <!-- URDF <mimic joint="joint7" multiplier="0.008"> on both jaws. -->
    <joint joint1="gripper_joint1" joint2="joint7" polycoef="0 0.008 0 0 0" />
    <joint joint1="gripper_joint2" joint2="joint7" polycoef="0 0.008 0 0 0" />
  </equality>
</mujocoinclude>

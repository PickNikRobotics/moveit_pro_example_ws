<?xml version="1.0" ?>
<robot name="mobile_fr3_duo">
    <group name="left_manipulator">
        <chain base_link="franka_spine" tip_link="left_grasp_link"/>
    </group>
    <group name="left_manipulator_without_spine">
        <chain base_link="left_fr3v2_link0" tip_link="left_grasp_link"/>
    </group>
    <group name="right_manipulator">
        <chain base_link="franka_spine" tip_link="right_grasp_link"/>
    </group>
    <group name="right_manipulator_without_spine">
        <chain base_link="right_fr3v2_link0" tip_link="right_grasp_link"/>
    </group>
    <group name="manipulator">
        <group name="left_manipulator"/>
        <group name="right_manipulator"/>
    </group>
    <group name="spine">
        <joint name="franka_spine_vertical_joint"/>
    </group>
    <group name="mobile_base">
        <joint name="planar_x"/>
        <joint name="planar_y"/>
        <joint name="planar_theta"/>
    </group>
    <group name="left_gripper">
        <link name="left_fr3v2_hand_tcp"/>
        <link name="left_fr3v2_leftfinger"/>
        <link name="left_fr3v2_rightfinger"/>
        <link name="left_grasp_link"/>
        <joint name="left_fr3v2_finger_joint1"/>
    </group>
    <group name="right_gripper">
        <link name="right_fr3v2_hand_tcp"/>
        <link name="right_fr3v2_leftfinger"/>
        <link name="right_fr3v2_rightfinger"/>
        <link name="right_grasp_link"/>
        <joint name="right_fr3v2_finger_joint1"/>
    </group>
    <!-- "ready": arm joints from franka_description robots/common/group_definition.xacro; spine and mobile base at their mock initial value 0.0 -->
    <group_state name="ready" group="left_manipulator">
        <joint name="franka_spine_vertical_joint" value="0"/>
        <joint name="left_fr3v2_joint1" value="0"/>
        <joint name="left_fr3v2_joint2" value="-0.7853981633974483"/>
        <joint name="left_fr3v2_joint3" value="0"/>
        <joint name="left_fr3v2_joint4" value="-2.356194490192345"/>
        <joint name="left_fr3v2_joint5" value="0"/>
        <joint name="left_fr3v2_joint6" value="1.5707963267948966"/>
        <joint name="left_fr3v2_joint7" value="0.7853981633974483"/>
    </group_state>
    <group_state name="ready" group="left_manipulator_without_spine">
        <joint name="left_fr3v2_joint1" value="0"/>
        <joint name="left_fr3v2_joint2" value="-0.7853981633974483"/>
        <joint name="left_fr3v2_joint3" value="0"/>
        <joint name="left_fr3v2_joint4" value="-2.356194490192345"/>
        <joint name="left_fr3v2_joint5" value="0"/>
        <joint name="left_fr3v2_joint6" value="1.5707963267948966"/>
        <joint name="left_fr3v2_joint7" value="0.7853981633974483"/>
    </group_state>
    <group_state name="ready" group="right_manipulator">
        <joint name="franka_spine_vertical_joint" value="0"/>
        <joint name="right_fr3v2_joint1" value="0"/>
        <joint name="right_fr3v2_joint2" value="-0.7853981633974483"/>
        <joint name="right_fr3v2_joint3" value="0"/>
        <joint name="right_fr3v2_joint4" value="-2.356194490192345"/>
        <joint name="right_fr3v2_joint5" value="0"/>
        <joint name="right_fr3v2_joint6" value="1.5707963267948966"/>
        <joint name="right_fr3v2_joint7" value="0.7853981633974483"/>
    </group_state>
    <group_state name="ready" group="right_manipulator_without_spine">
        <joint name="right_fr3v2_joint1" value="0"/>
        <joint name="right_fr3v2_joint2" value="-0.7853981633974483"/>
        <joint name="right_fr3v2_joint3" value="0"/>
        <joint name="right_fr3v2_joint4" value="-2.356194490192345"/>
        <joint name="right_fr3v2_joint5" value="0"/>
        <joint name="right_fr3v2_joint6" value="1.5707963267948966"/>
        <joint name="right_fr3v2_joint7" value="0.7853981633974483"/>
    </group_state>
    <group_state name="ready" group="manipulator">
        <joint name="franka_spine_vertical_joint" value="0"/>
        <joint name="left_fr3v2_joint1" value="0"/>
        <joint name="left_fr3v2_joint2" value="-0.7853981633974483"/>
        <joint name="left_fr3v2_joint3" value="0"/>
        <joint name="left_fr3v2_joint4" value="-2.356194490192345"/>
        <joint name="left_fr3v2_joint5" value="0"/>
        <joint name="left_fr3v2_joint6" value="1.5707963267948966"/>
        <joint name="left_fr3v2_joint7" value="0.7853981633974483"/>
        <joint name="right_fr3v2_joint1" value="0"/>
        <joint name="right_fr3v2_joint2" value="-0.7853981633974483"/>
        <joint name="right_fr3v2_joint3" value="0"/>
        <joint name="right_fr3v2_joint4" value="-2.356194490192345"/>
        <joint name="right_fr3v2_joint5" value="0"/>
        <joint name="right_fr3v2_joint6" value="1.5707963267948966"/>
        <joint name="right_fr3v2_joint7" value="0.7853981633974483"/>
    </group_state>
    <group_state name="ready" group="spine">
        <joint name="franka_spine_vertical_joint" value="0"/>
    </group_state>
    <group_state name="ready" group="mobile_base">
        <joint name="planar_x" value="0"/>
        <joint name="planar_y" value="0"/>
        <joint name="planar_theta" value="0"/>
    </group_state>
    <!-- "open" and "close": franka_description end_effectors/franka_hand/franka_hand.srdf.xacro -->
    <group_state name="open" group="left_gripper">
        <joint name="left_fr3v2_finger_joint1" value="0.035"/>
    </group_state>
    <group_state name="close" group="left_gripper">
        <joint name="left_fr3v2_finger_joint1" value="0"/>
    </group_state>
    <group_state name="open" group="right_gripper">
        <joint name="right_fr3v2_finger_joint1" value="0.035"/>
    </group_state>
    <group_state name="close" group="right_gripper">
        <joint name="right_fr3v2_finger_joint1" value="0"/>
    </group_state>
    <end_effector name="left_hand" parent_link="left_grasp_link" group="left_gripper" parent_group="left_manipulator_without_spine"/>
    <end_effector name="right_hand" parent_link="right_grasp_link" group="right_gripper" parent_group="right_manipulator_without_spine"/>
    <passive_joint name="left_fr3v2_finger_joint2"/>
    <passive_joint name="right_fr3v2_finger_joint2"/>
    <disable_collisions link1="argo_drive_front_fixed_link" link2="argo_drive_front_link" reason="Adjacent" />
    <disable_collisions link1="argo_drive_front_fixed_link" link2="argo_drive_rear_fixed_link" reason="Never" />

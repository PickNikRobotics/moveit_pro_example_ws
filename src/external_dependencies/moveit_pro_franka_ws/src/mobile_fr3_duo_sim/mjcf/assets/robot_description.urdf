    <parent link="caster_front_left_fixed_link"/>
    <child link="caster_front_left_steering_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="500" velocity="20"/>
    <dynamics damping="0.003" friction="0.0"/>
  </joint>
  <link name="caster_front_left_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder length="0.015" radius="0.03"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>

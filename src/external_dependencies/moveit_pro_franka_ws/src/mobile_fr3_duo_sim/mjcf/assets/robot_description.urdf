  <joint name="right_fr3v2_finger_joint1" type="prismatic">
    <parent link="right_fr3v2_hand"/>
    <child link="right_fr3v2_leftfinger"/>
    <origin rpy="0 0 0" xyz="0 0 0.0584"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="0.0" upper="0.04" velocity="0.2"/>

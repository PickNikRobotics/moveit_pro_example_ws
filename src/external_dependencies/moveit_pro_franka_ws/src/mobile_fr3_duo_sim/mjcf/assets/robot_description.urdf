<?xml version="1.0" ?>
<robot name="mobile_fr3_duo">
  <mujoco>
    <option integrator="implicitfast">
      <flag multiccd="enable" />
    </option>
    <compiler fusestatic="false" discardvisual="false" />
  </mujoco>
  <link name="world"/>
  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base"/>
  </joint>
  <!-- Planar base pose (x, y, yaw) as joints between the fixed base and the robot's base_link -->
  <link name="base"/>
  <!-- MuJoCo rejects massless moving bodies; values from hangar_sim's planar base body -->
  <link name="virtual_x">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <link name="virtual_y">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="planar_x" type="prismatic">
    <parent link="base"/>
    <child link="virtual_x"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000.0" lower="-10.0" upper="10.0" velocity="0.35"/>
  </joint>
  <joint name="planar_y" type="prismatic">
    <parent link="virtual_x"/>
    <child link="virtual_y"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-10.0" upper="10.0" velocity="0.35"/>
  </joint>
  <joint name="planar_theta" type="continuous">
    <parent link="virtual_y"/>
    <child link="base_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" velocity="0.5"/>
  </joint>
  <!-- ========================================= -->
  <!-- ||         Inertia Utilities           || -->
  <!-- ========================================= -->
  <!-- ========================================= -->
  <!-- ||         Inertia Utilities           || -->
  <!-- ========================================= -->
  <!-- ========================================= -->
  <!-- ||         Inertia Utilities           || -->
  <!-- ========================================= -->
  <!-- ========================================= -->
  <!-- ||         Inertia Utilities           || -->
  <!-- ========================================= -->
  <!-- Main Platform Chassis -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://franka_description/meshes/robots/tmrv0_2/collision/tmrv0_2.stl"/>
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://franka_description/meshes/robots/tmrv0_2/collision/tmrv0_2.stl"/>
      </geometry>
    </collision>
  </link>
  <link name="base_inertia">
    <inertial>
      <origin rpy="0 0 0" xyz="0.006619 -0.002210 0.184355"/>
      <mass value="88.954183"/>
      <inertia ixx="3.245524271774" ixy="0.007060314402" ixz="-0.134604220439" iyy="4.162370636125" iyz="-0.010770547630" izz="5.841473351812"/>
    </inertial>
  </link>
  <joint name="base_inertia_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_inertia"/>
  </joint>
  <link name="caster_front_left_fixed_link">
    <visual>
      <origin xyz="0 0 -0.0015"/>
      <geometry>

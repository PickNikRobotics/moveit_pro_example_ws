<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Estimate Visual Odometry Square">
  <BehaviorTree
    ID="Estimate Visual Odometry Square"
    _description="Requires enabled stereo cameras and an authorized VO model bundle mounted in the Runtime. Select CPU or CUDA explicitly; CUDA requires a compatible NVIDIA-enabled Runtime. VO observes the wheel/IMU-controlled 1.8 m square without controlling the rover, aborts on tracking loss, and requests STOP on every exit."
    _favorite="false"
  >
    <Control
      ID="Finally"
      name="Stop visual odometry on every exit"
      halt_timeout_msec="70000"
    >
      <Control
        ID="Sequence"
        name="Measure the dead-reckon square with stereo VO"
      >
        <Action
          ID="StopStereoVisualOdometry"
          response_timeout="5.0"
          reinitializations="{baseline_reinitializations}"
        />
        <Action
          ID="ResetStereoVisualOdometry"
          reset_pose="true"
          response_timeout="5.0"
        />
        <Action ID="StartStereoVisualOdometry" response_timeout="60.0" />
        <Decorator ID="Timeout" msec="30000">
          <Decorator ID="RetryUntilSuccessful" num_attempts="-1">
            <Control ID="Sequence" name="Wait for the first tracked pose">
              <Action ID="WaitForDuration" delay_duration="0.1" />
              <Action
                ID="GetStereoVisualOdometryStatus"
                response_timeout="5.0"
                runtime_state="{startup_runtime_state}"
                tracking_state="{startup_tracking_state}"
                synchronized_frames="{startup_synchronized_frames}"
                rejected_frames="{startup_rejected_frames}"
                reinitializations="{startup_reinitializations}"
                status_message="{startup_status_message}"
              />
              <Condition
                ID="ScriptCondition"
                code="startup_runtime_state == 1 &amp;&amp; startup_tracking_state == 'tracking' &amp;&amp; startup_reinitializations == baseline_reinitializations"
              />
            </Control>
          </Decorator>
        </Decorator>
        <Decorator ID="Timeout" msec="90000">
          <Control
            ID="Parallel"
            success_count="1"
            failure_count="1"
            name="Drive while continuous tracking remains healthy"
          >
            <SubTree ID="Dead Reckon Square" _collapsed="true" />
            <Decorator ID="RepeatUnlessFailureEachTick" num_cycles="-1">
              <Control
                ID="Sequence"
                name="Reject tracking loss during the route"
              >
                <Action
                  ID="GetStereoVisualOdometryStatus"
                  response_timeout="5.0"
                  runtime_state="{route_runtime_state}"
                  tracking_state="{route_tracking_state}"
                  synchronized_frames="{route_synchronized_frames}"
                  rejected_frames="{route_rejected_frames}"
                  reinitializations="{route_reinitializations}"
                  status_message="{route_status_message}"
                />
                <Control ID="Fallback" name="Report rejected route tracking">
                  <Condition
                    ID="ScriptCondition"
                    code="route_runtime_state == 1 &amp;&amp; route_tracking_state == 'tracking' &amp;&amp; route_reinitializations == baseline_reinitializations"
                  />
                  <Control ID="Sequence" name="Explain route tracking failure">
                    <Action
                      ID="Script"
                      code="vo_failure_message := 'VO square tracking rejected: runtime=' .. route_runtime_state .. ', tracking=' .. route_tracking_state .. ', reinitializations=' .. route_reinitializations .. ' (baseline=' .. baseline_reinitializations .. '). Status: ' .. route_status_message .. '. Check stereo inputs and VO diagnostics before retrying.'"
                    />
                    <Action
                      ID="LogMessage"
                      log_level="error"
                      message="{vo_failure_message}"
                    />
                    <Action ID="AlwaysFailure" />
                  </Control>
                </Control>
                <Action ID="WaitForDuration" delay_duration="0.1" />
              </Control>
            </Decorator>
          </Control>
        </Decorator>
        <Action
          ID="GetStereoVisualOdometryStatus"
          response_timeout="5.0"
          runtime_state="{final_runtime_state}"
          tracking_state="{final_tracking_state}"
          synchronized_frames="{final_synchronized_frames}"
          rejected_frames="{final_rejected_frames}"
          reinitializations="{final_reinitializations}"
          status_message="{final_status_message}"
        />
        <Control ID="Fallback" name="Report rejected final tracking">
          <Condition
            ID="ScriptCondition"
            code="final_runtime_state == 1 &amp;&amp; final_tracking_state == 'tracking' &amp;&amp; final_reinitializations == baseline_reinitializations"
          />
          <Control ID="Sequence" name="Explain final tracking failure">
            <Action
              ID="Script"
              code="vo_failure_message := 'VO square final tracking rejected: runtime=' .. final_runtime_state .. ', tracking=' .. final_tracking_state .. ', reinitializations=' .. final_reinitializations .. ' (baseline=' .. baseline_reinitializations .. '). Status: ' .. final_status_message .. '. Check stereo inputs and VO diagnostics before retrying.'"
            />
            <Action
              ID="LogMessage"
              log_level="error"
              message="{vo_failure_message}"
            />
            <Action ID="AlwaysFailure" />
          </Control>
        </Control>
      </Control>
      <Action ID="StopStereoVisualOdometry" response_timeout="65.0" />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Estimate Visual Odometry Square">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Visual Odometry" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

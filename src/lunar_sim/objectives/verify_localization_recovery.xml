<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Verify Localization Recovery">
  <BehaviorTree
    ID="Verify Localization Recovery"
    _description="Seeds beluga_amcl at seed_pose, refines it in place, and fails unless the front lidar fits the shipped map."
    _favorite="false"
  >
    <Control ID="Sequence" name="root">
      <Action ID="SetInitialPose" name="Seed the filter" pose="{seed_pose}" />
      <Action
        ID="WaitForDuration"
        name="Let the filter take the seed"
        delay_duration="0.300000"
      />
      <!--Each call updates the filter on the next scan; the wait gives each call a fresh scan.-->
      <Decorator ID="RepeatUnlessFailureEachTick" num_cycles="{num_updates}">
        <Control ID="Sequence">
          <Action
            ID="CallEmptyService"
            name="Request a filter update"
            service_name="/request_nomotion_update"
            response_timeout="2.000000"
          />
          <Action ID="WaitForDuration" delay_duration="0.150000" />
        </Control>
      </Decorator>
      <Action
        ID="GetLatestTransform"
        name="Read the refined pose"
        target_frame_id="map"
        source_frame_id="footprint"
        transform="{refined_transform}"
      />
      <Action
        ID="ConvertTransformStampedToPoseStamped"
        transform_stamped="{refined_transform}"
        pose_stamped="{refined_pose}"
      />
      <Action ID="GetOccupancyGrid" topic_name="/map" message_out="{map}" />
      <Action
        ID="GetLaserScan"
        topic_name="/scan_front_filtered"
        message_out="{front_scan}"
      />
      <!--max_range mirrors amcl laser_max_range in params/nav2_params.yaml.-->
      <Action
        ID="ScanMatchResidual"
        name="Check the front lidar against the shipped map"
        pose="{refined_pose}"
        scan="{front_scan}"
        map="{map}"
        base_frame_id="footprint"
        max_range="5.0"
        inlier_distance="{inlier_distance}"
        min_inlier_fraction="{min_inlier_fraction}"
      />
      <Action
        ID="LogMessage"
        log_level="info"
        message="Localization recovered and verified."
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Verify Localization Recovery">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
      <input_port
        name="seed_pose"
        default="{recovery_pose}"
        type="geometry_msgs::msg::PoseStamped"
      >
        Pose to seed, in map.
      </input_port>
      <input_port name="num_updates" default="20" type="int">
        Number of filter updates.
      </input_port>
      <input_port name="inlier_distance" type="double">
        A beam fits if it lands within this distance of an obstacle, metres.
      </input_port>
      <input_port name="min_inlier_fraction" type="double">
        Minimum fraction of beams that must fit.
      </input_port>
    </SubTree>
  </TreeNodesModel>
</root>

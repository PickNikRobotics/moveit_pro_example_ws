<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="husky_a300">
  <!-- A300 platform body from clearpathrobotics/clearpath_common's clearpath_platform_description
       package (BSD-licensed), vendored under ../../external_dependencies and kept byte-identical to
       upstream. This file supplies its own MuJoCo ros2_control block below, so
       use_platform_controllers:=false keeps the upstream ros2_control include out of the build. -->
  <xacro:arg name="use_platform_controllers" default="false" />
  <!-- a300.urdf.xacro declares this arg with a default that resolves $(find clearpath_control), a
       package this config never uses (no Gazebo) and does not vendor. Declaring it first wins: xacro
       only applies an <xacro:arg> default for a name it has not already seen, so the upstream
       default is never evaluated. -->
  <xacro:arg name="gazebo_controllers" default="unused" />
  <xacro:include filename="$(find clearpath_platform_description)/urdf/common.urdf.xacro" />
  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/a300.urdf.xacro" />
  <xacro:a300 control="diff_4wd" front_wheels="outdoor" rear_wheels="outdoor" />

  <!-- FRAME NAMING: see README.md for the full footprint-vs-base_footprint explanation.
       Unchanged by the MuJoCo migration. -->
  <link name="footprint" />
  <joint name="footprint_joint" type="fixed">
    <parent link="footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.13597" rpy="0 0 0" />
  </joint>

  <!-- Attachments: the standard A300 accessory kit (front/rear bumper, sensor enclosure, sensor
       arch), for visual/body fidelity with the real robot. No sensors are mounted on the robot -
       the only camera in this configuration is husky_scene.xml's mast-mounted, world-fixed
       scene_camera, published because render_publish_rate below is non-zero. -->
  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/bumper.urdf.xacro" />
  <xacro:bumper name="front_bumper" model="default" parent_link="front_bumper_mount" extension="0.0">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </xacro:bumper>
  <xacro:bumper name="rear_bumper" model="default" parent_link="rear_bumper_mount" extension="0.0">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </xacro:bumper>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/amp_enclosure.urdf.xacro" />
  <xacro:amp_enclosure name="enclosure" model="amp_enclosure" parent_link="base_link">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </xacro:amp_enclosure>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/amp_sensor_arch.urdf.xacro" />
  <xacro:amp_sensor_arch name="sensor_arch" model="amp_sensor_arch" parent_link="enclosure_antenna_mount">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </xacro:amp_sensor_arch>

  <!-- MuJoCo hardware: real physics, driven by description/husky_scene.xml (see that file and
       husky_a300.xml for the body/wheel/actuator model). Wheel joint names match
       clearpath_platform_description/urdf/a300/drivetrain/wheels/outdoor.urdf.xacro
       (front_left_wheel_joint etc.), same names the mock hardware block used, and the same
       names the MJCF wheel joints in husky_a300.xml declare. -->
  <xacro:arg name="mujoco_model" default="description/husky_scene.xml" />
  <xacro:arg name="mujoco_viewer" default="false" />
  <!-- Names the keyframe (husky_scene.xml's <keyframe>) that the MoveIt Pro UI's built-in
       "Reset Simulation" control and MujocoBehaviorsLoader's ResetMujocoKeyframe Behavior use by
       default - same pattern as moveit_pro_kinova_configs' space_satellite_sim.xacro. -->
  <xacro:arg name="mujoco_keyframe" default="default" />
  <ros2_control name="husky_a300_hardware" type="system">
    <hardware>
      <plugin>picknik_mujoco_ros/MujocoSystem</plugin>
      <param name="mujoco_model">$(arg mujoco_model)</param>
      <param name="mujoco_model_package">lunar_sim</param>
      <param name="mujoco_viewer">$(arg mujoco_viewer)</param>
      <param name="mujoco_keyframe">$(arg mujoco_keyframe)</param>
      <!-- TF ownership: robot_state_publisher owns every link below footprint (footprint ->
           base_link -> chassis_link -> wheels ...) and platform_velocity_controller owns
           odom -> footprint. MuJoCo must not broadcast mj_world -> chassis_link (that 60 Hz edge
           would beat the static base_link -> chassis_link and split the tree in two). With
           odom_frame set, publish_mj_world_tf=true makes MujocoSystem publish mj_world -> odom as
           identity instead (mujoco_system.cpp, publish_sites), which is what connects the
           world-fixed scene_camera_optical_frame site (parented to mj_world, husky_scene.xml) to
           odom so /scene_camera/points can be shown in the odom frame. base_link_name stops the
           site TF fill-in at the chassis body instead of walking up to the MJCF worldbody. Ground
           truth for the Dead Reckon Square calibration comes from the chassis freejoint pose read
           from MuJoCo directly, not from TF. -->
      <param name="publish_mj_world_tf">true</param>
      <param name="odom_frame">odom</param>
      <param name="base_link_name">chassis_link</param>
      <param name="tf_publish_rate">60</param>
      <param name="render_publish_rate">10</param>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
</robot>

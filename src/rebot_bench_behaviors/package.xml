<?xml version="1.0" ?>
<package format="3">
  <name>rebot_bench_behaviors</name>
  <version>10.2.0</version>
  <description>
    Cube perception and trajectory Behaviors shared by the simulated and
    physical reBot bench.
  </description>
  <maintainer email="support@picknik.ai">MoveIt Pro Maintainer</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>moveit_pro_package</build_depend>
  <depend>moveit_pro_behavior_interface</depend>
  <depend>trajectory_msgs</depend>
  <depend>pluginlib</depend>
  <depend>cv_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_studio_vision_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>
  <test_depend>moveit_pro_test_utils</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_clang_format</test_depend>
  <test_depend>ament_clang_tidy</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

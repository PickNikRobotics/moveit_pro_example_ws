<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Close Gripper">
  <BehaviorTree
    ID="Close Gripper"
    _description="Close the gripper"
    _favorite="false"
  >
    <Control ID="Sequence" name="root">
      <!--The recorded `action` gets its gripper channel from here: a
           GripperCommand goal is not observable on any topic.-->
      <Action
        ID="SetRos2Parameter"
        node_name="/joint_command_bridge"
        parameter_name="gripper_command_position"
        parameter_value="0.7"
        parameter_type="double"
        response_timeout="5.000000"
        wait_for_server_available_timeout="3.000000"
      />
      <Action
        ID="MoveGripperAction"
        gripper_command_action_name="/robotiq_gripper_controller/gripper_cmd"
        position="0.7"
        timeout="15.000000"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Close Gripper">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Grasping" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

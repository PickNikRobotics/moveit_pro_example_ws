<?xml version="1.0" encoding="UTF-8" ?>
<root
  BTCPP_format="4"
  main_tree_to_execute="Stack Cubes with the VLA Policy or Fail When Time Runs Out"
>
  <!--
    The policy branch of the Objectives that end the run once the cubes are
    stacked. When the policy run ends on its own, the Sequence logs why and
    fails, so only a check or detector around this Subtree ends the run as
    SUCCESS. Those Objectives check for the stack the prompt asks for, so a
    new prompt needs a matching check or question. The ExecutePolicy ports
    match Stack Cubes with the VLA Policy; a different checkpoint changes the
    same ports in both.
  -->
  <BehaviorTree
    ID="Stack Cubes with the VLA Policy or Fail When Time Runs Out"
    _description="Runs the cube-stacking VLA policy and fails when its 300-step budget, 30 s of policy motion, runs out or the policy ends the run. It never returns SUCCESS. A check ahead of it in a ReactiveFallback, or a detector next to it under a Parallel, ends the run when the cubes are stacked."
    _favorite="false"
  >
    <Control ID="Sequence">
      <Action
        ID="ExecutePolicy"
        name="ExecutePolicy"
        policy_service_name="/get_action_chunk"
        joint_group_name="manipulator"
        prompt="stack the blue cube on the green cube"
        total_action_steps="300"
        dt="0.1"
        committed_action_steps="20"
        num_interpolation_points="200"
        goal_path_tolerance="0.5"
        policy_tracking_weight="300.0"
        policy_uses_real_time_chunking="true"
        guidance_horizon="18"
        policy_call_timeout="10.0"
        image_topics="/scene_camera/color;/wrist_camera/color;/overview_camera/color"
        image_names="scene;wrist;overview"
        joint_states_topic="/joint_states"
        absolute_force_torque_threshold="250;250;250;80;80;80"
        gripper_command_action_name="/robotiq_gripper_controller/gripper_cmd"
        gripper_joint_name="robotiq_85_left_knuckle_joint"
      />
      <Action
        ID="LogMessage"
        message="The policy run ended before the cubes were stacked."
        log_level="error"
      />
      <Action ID="AlwaysFailure" />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Stack Cubes with the VLA Policy or Fail When Time Runs Out">
      <MetadataFields>
        <Metadata subcategory="Application - VLA Examples" />
        <Metadata runnable="false" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

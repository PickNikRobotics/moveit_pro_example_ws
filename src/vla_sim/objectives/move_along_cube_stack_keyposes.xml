<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Move Along Cube-Stack Keyposes">
  <!--
    `held_object_frame` names what the tip is carrying, so the keyposes position that
    object instead of the tip. Pass `pinch` to carry nothing, which makes the offset
    identity.

    `tip_offset` spans grasp_link, the URDF planning tip, and `pinch`, the MJCF site the
    oracle aims at. Both are fixed to robotiq_85_base_link along its approach axis, so the
    offset is a pure translation; the yaw between them lands the same grasp on a square
    cube.

    Leave `reuse_orientation` unwired to choose a grasp orientation, and wire it from an
    earlier segment's `orientation` for any move made while holding a cube.

    `mj_world` is the MJCF worldbody, which `PlanJointSplineThroughPoses` solves in as the
    robot model frame. The two coincide: the URDF fixes base_link 0.02 m above `world`, and
    cube_stack_scene.xml puts the Kinova base at that same height above the worldbody. A
    scene that moved the base relative to either origin would need the poses transformed.
  -->
  <BehaviorTree
    ID="Move Along Cube-Stack Keyposes"
    _description="Plan and execute one top-down segment of the stacking oracle."
    _favorite="false"
  >
    <Control ID="Sequence" name="root">
      <Action
        ID="GetLatestTransform"
        target_frame_id="mj_world"
        source_frame_id="{aim_frame}"
        transform="{aim_transform}"
      />
      <Action
        ID="ConvertTransformStampedToPoseStamped"
        transform_stamped="{aim_transform}"
        pose_stamped="{aim_pose}"
      />
      <Action
        ID="GetLatestTransform"
        target_frame_id="pinch"
        source_frame_id="{held_object_frame}"
        transform="{held_object_offset}"
      />
      <Action
        ID="GetCurrentPlanningScene"
        planning_scene_msg="{planning_scene}"
      />
      <Action
        ID="GetJointState"
        planning_scene="{planning_scene}"
        planning_group_name="manipulator"
        joint_state="{seed_joint_state}"
        robot_joint_state="{robot_joint_state}"
      />
      <Action
        ID="ComputeTopDownKeyposes"
        aim_pose="{aim_pose}"
        seed_joint_state="{seed_joint_state}"
        planning_group_name="manipulator"
        tip_link="grasp_link"
        held_object_offset="{held_object_offset}"
        heights="{heights}"
        reuse_orientation="{reuse_orientation}"
        path="{path}"
        orientation="{orientation}"
      />
      <Action
        ID="PlanJointSplineThroughPoses"
        path="{path}"
        seed_joint_state="{seed_joint_state}"
        planning_group_name="manipulator"
        tip_link="grasp_link"
        tip_offset="0.0;0.0;-0.005"
        cartesian_speed="0.065"
        joint_velocity_scale="0.5"
        sampling_rate="100"
        joint_trajectory_msg="{joint_trajectory_msg}"
      />
      <Action
        ID="ExecuteTrajectory"
        joint_trajectory_msg="{joint_trajectory_msg}"
      />
    </Control>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="Move Along Cube-Stack Keyposes">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Application - VLA Examples" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

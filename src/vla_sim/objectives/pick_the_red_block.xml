<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Pick the Red Block">
  <!--
    A scripted stand-in for a teleoperated demonstration, reaching the same phases
    an oracle policy does: approach from above, descend to the grasp, close, lift.
    It reads the cube's pose out of the simulation rather than out of perception.

    `cube_red_tf` is a MuJoCo site on the cube's centroid, which picknik_mujoco_ros
    publishes to TF whenever `tf_publish_rate` is set. Its orientation is the cube's
    own, which is not a grasp, so a top-down one replaces it before the pick plans
    against the pose.

    The Objective does not reset the scene, so run **Reset MuJoCo Sim** between
    attempts. **Collect the Red Block Pick** resets on its own, ahead of the
    recording window.
  -->
  <BehaviorTree
    ID="Pick the Red Block"
    _description="Pick up the red block from its simulated pose, failing if the cube does not come with the gripper."
    _favorite="true"
  >
    <Control ID="Sequence" name="root">
      <SubTree ID="Open Gripper" _collapsed="true" />
      <Action
        ID="GetLatestTransform"
        target_frame_id="world"
        source_frame_id="cube_red_tf"
        transform="{cube_transform}"
      />
      <Action
        ID="ConvertTransformStampedToPoseStamped"
        transform_stamped="{cube_transform}"
        pose_stamped="{cube_pose}"
      />
      <!--Straight down at the cube, yawed a quarter turn about world Z.-->
      <Action
        ID="OverridePoseOrientation"
        input_pose="{cube_pose}"
        orientation_xyzw="0.7071068;-0.7071068;0;0"
        output_pose="{grasp_pose}"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="Red Block Grasp"
        marker_size="0.100000"
        pose="{grasp_pose}"
      />
      <!--Approach and retract along the tool's own axis, so both are vertical.-->
      <SubTree
        ID="Pick from Pose"
        _collapsed="true"
        grasp_pose="{grasp_pose}"
        approach_distance="0.12"
        retract_xyz="0;0;-0.12"
      />
      <!--
        Every Behavior above succeeds whether or not the cube came with the
        gripper, so without this the Objective reports a demonstration it did
        not perform. A missed grasp leaves the cube within a millimetre or two
        of where it started, which the tolerance clears by an order of
        magnitude. The rotation tolerance sits above pi, the most AngleAxis
        reports, so displacement decides on its own.
      -->
      <Control ID="Sequence" name="confirm_the_cube_came_along">
        <!--ExecuteTrajectory returns while the arm is still rising.-->
        <Action ID="WaitForDuration" delay_duration="0.5" />
        <Action
          ID="GetLatestTransform"
          target_frame_id="world"
          source_frame_id="cube_red_tf"
          transform="{lifted_transform}"
        />
        <Action
          ID="ConvertTransformStampedToPoseStamped"
          transform_stamped="{lifted_transform}"
          pose_stamped="{lifted_pose}"
        />
        <Action
          ID="CalculatePoseOffset"
          source_pose="{cube_pose}"
          destination_pose="{lifted_pose}"
          source_to_destination_pose="{lift_offset}"
        />
        <Decorator ID="Inverter">
          <Action
            ID="IsPoseNearIdentity"
            pose="{lift_offset}"
            position_tolerance="0.02"
            rotation_tolerance="3.15"
          />
        </Decorator>
      </Control>
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Pick the Red Block">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Application - VLA Examples" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

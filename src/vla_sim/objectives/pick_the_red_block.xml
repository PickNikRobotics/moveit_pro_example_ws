<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Pick the Red Block">
  <!--
    A scripted stand-in for a teleoperated demonstration. It reaches the phases an
    oracle policy does - approach from above, descend to the grasp, close, lift -
    reading the cube's pose out of the simulation rather than out of perception.

    `cube_red_tf` is a MuJoCo site on the cube's centroid, which picknik_mujoco_ros
    publishes to TF whenever `tf_publish_rate` is set. Its orientation is the cube's
    own, which is not a grasp, so a top-down one replaces it before the pick plans
    against the pose.

    The Objective does not reset the scene, so run **Reset MuJoCo Sim** between
    attempts. **Collect the Red Block Pick** resets on its own, ahead of the
    recording window.
  -->
  <BehaviorTree
    ID="Pick the Red Block"
    _description="Pick up the red block from its simulated pose, without recording."
    _favorite="true"
  >
    <Control ID="Sequence" name="root">
      <SubTree ID="Open Gripper" _collapsed="true" />
      <Action
        ID="GetLatestTransform"
        target_frame_id="world"
        source_frame_id="cube_red_tf"
        transform="{cube_transform}"
      />
      <Action
        ID="ConvertTransformStampedToPoseStamped"
        transform_stamped="{cube_transform}"
        pose_stamped="{cube_pose}"
      />
      <!--Point the tool straight down at the cube: 180 degrees about x.-->
      <Action
        ID="OverridePoseOrientation"
        input_pose="{cube_pose}"
        orientation_xyzw="0;1;0;0"
        output_pose="{grasp_pose}"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="Red Block Grasp"
        marker_size="0.100000"
        pose="{grasp_pose}"
      />
      <!--Approach and retract along the tool's own axis, so both are vertical.-->
      <SubTree
        ID="Pick from Pose"
        _collapsed="true"
        grasp_pose="{grasp_pose}"
        approach_distance="0.12"
        retract_xyz="0;0;-0.12"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Pick the Red Block">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Application - VLA Examples" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

<launch>
  <!-- HTTPS selects an externally managed server; HTTP is restricted to literal loopback addresses. -->
  <arg
    name="infer_url"
    default="$(env INFER_URL 'http://127.0.0.1:8973/infer')"
  />
  <arg name="http_timeout" default="$(env MOVEIT_INFERENCE_HTTP_TIMEOUT 9.0)" />
  <include
    file="$(find-pkg-share moveit_studio_agent)/launch/runtime_services.launch.xml"
  />
  <!-- Bridges ExecutePolicy's /get_action_chunk service to the inference server over
       HTTP. Lightweight (no ML dependencies), so it always runs with the config; when
       the server is down it fails requests with an actionable message instead. -->
  <node
    pkg="vla_sim"
    exec="get_action_chunk_adapter.py"
    name="get_action_chunk_adapter"
    output="both"
    emulate_tty="true"
  >
    <param name="infer_url" value="$(var infer_url)" />
    <!-- Without type="float", launch passes an integer MOVEIT_INFERENCE_HTTP_TIMEOUT
         as an int, and the node declares http_timeout as a double, so the node
         fails to start. Every Objective calling this adapter must set
         policy_call_timeout above http_timeout. -->
    <param name="http_timeout" value="$(var http_timeout)" type="float" />
  </node>

  <!-- Nyx path-traced cameras for MOVEIT_PRO_CAMERA_RENDERER nyx or both, one node per camera. The robot description defines the values and the default, and fails on any other. picknik_nyx_renderer is an optional dependency: only images with the Nyx runtime ship it. -->
  <let name="camera_renderer" value="$(env MOVEIT_PRO_CAMERA_RENDERER '')" />
  <let
    name="nyx_enabled"
    value="$(eval '&quot;$(var camera_renderer)&quot; in (&quot;nyx&quot;, &quot;both&quot;)')"
  />
  <let
    name="nyx_namespace"
    value="$(eval '&quot;nyx&quot; if &quot;$(var camera_renderer)&quot; == &quot;both&quot; else &quot;&quot;')"
  />
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera.launch.py"
    if="$(var nyx_enabled)"
  >
    <arg
      name="mjcf"
      value="$(find-pkg-share vla_sim)/description/mujoco/cube_stack_scene.xml"
    />
    <arg
      name="scene_dir"
      value="$(env USER_WS $(env HOME)/user_ws)/.nyx_scenes/vla_sim"
    />
    <arg name="camera" value="overview_camera" />
    <arg name="topic_namespace" value="$(var nyx_namespace)" />
  </include>
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera.launch.py"
    if="$(var nyx_enabled)"
  >
    <arg
      name="mjcf"
      value="$(find-pkg-share vla_sim)/description/mujoco/cube_stack_scene.xml"
    />
    <arg
      name="scene_dir"
      value="$(env USER_WS $(env HOME)/user_ws)/.nyx_scenes/vla_sim"
    />
    <arg name="camera" value="scene_camera" />
    <arg name="topic_namespace" value="$(var nyx_namespace)" />
  </include>
  <include
    file="$(find-pkg-share picknik_nyx_renderer)/launch/nyx_camera.launch.py"
    if="$(var nyx_enabled)"
  >
    <arg
      name="mjcf"
      value="$(find-pkg-share vla_sim)/description/mujoco/cube_stack_scene.xml"
    />
    <arg
      name="scene_dir"
      value="$(env USER_WS $(env HOME)/user_ws)/.nyx_scenes/vla_sim"
    />
    <arg name="camera" value="wrist_camera" />
    <arg name="topic_namespace" value="$(var nyx_namespace)" />
  </include>
</launch>

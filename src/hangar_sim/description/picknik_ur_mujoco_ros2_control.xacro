<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Which renderer produces the scene_camera and wrist_camera color topics: opengl (the default), nyx, or both, as documented in lab_sim's picknik_ur.xacro; both is for side-by-side comparison only, since nothing then publishes <camera>/color. The forward stereo pair stays on MuJoCo. runtime.launch.xml reads the same variable to start one Nyx node per camera. An empty value means opengl; an unrecognized one fails the description rather than leaving the config with no camera. -->
  <xacro:arg
    name="camera_renderer"
    default="$(optenv MOVEIT_PRO_CAMERA_RENDERER opengl)"
  />
  <xacro:if value="${'$(arg camera_renderer)' not in ('', 'opengl', 'nyx', 'both')}">${xacro.fatal("MOVEIT_PRO_CAMERA_RENDERER is '$(arg camera_renderer)' for the robot description; set it to opengl, nyx or both, or leave it unset for opengl.")}</xacro:if>
  <xacro:macro name="picknik_ur_mujoco_ros2_control" params="mujoco_model mujoco_viewer:=false publish_odom:=true enable_vo:=false">

    <ros2_control name="ur_mujoco_control" type="system">
      <!-- Sensor names match the MJCF <camera> names. These publish an organized
           PointCloud2, never a LaserScan, so the override is points_topic rather
           than the <rangefinder> path's topic. lidar_flattener converts each
           cloud back into /scan_{front,rear}, leaving every consumer unchanged.
           Names are absolute so they stay out of this node's namespace. -->
      <sensor name="lidar_front">
        <param name="points_topic">/lidar_front/points</param>
      </sensor>
      <sensor name="lidar_rear">
        <param name="points_topic">/lidar_rear/points</param>
      </sensor>
      <!-- The forward stereo pair exists for visual odometry and has no other consumer.
           Off by default: MuJoCo renders every fixed MJCF camera on the render timer
           whether or not anything subscribes, so leaving the pair on costs two 1280x720
           offscreen passes at 20 Hz and puts four image topics in the operator's camera
           picker that nobody can use. `camera_enabled` drops the cameras from the plugin's
           configs entirely, so they are neither rendered nor advertised. -->
      <xacro:unless value="${enable_vo}">
        <sensor name="forward_stereo_left">
          <param name="camera_enabled">false</param>
        </sensor>
        <sensor name="forward_stereo_right">
          <param name="camera_enabled">false</param>
        </sensor>
      </xacro:unless>
      <!-- Publish MuJoCo's renders as image_raw inside the same /forward_stereo/{left,right}/
           namespace as the rectified pair, so all four image topics group under one entry in
           the operator's camera picker instead of splitting across two top-level names. The
           renders are an rgb8 simulator artifact with no counterpart on a real OAK-D, whose
           stereo sensors are monochrome; forward_stereo_publisher converts them to the mono8
           image_rect pair that is the actual contract. Those rectified names are unchanged.

           The plugin's per-camera camera_info is kept off the ROS sibling name of both image
           topics. It carries the same K and frame_id as the stereo contract but P[3]=0, so a
           consumer resolving camera_info by the sibling convention would read a zero baseline
           and infer infinite depth from finite disparity, with nothing to flag the mistake.
           The sibling name now resolves to the calibrated stereo camera_info, which describes
           these renders correctly too: distortion is zero and rectification is identity, so
           raw and rectified differ only in encoding. -->
      <xacro:if value="${enable_vo}">
        <sensor name="forward_stereo_left">
          <param name="rgb_topic">/forward_stereo/left/image_raw</param>
          <param name="camera_info_topic">/forward_stereo/left/monocular_camera_info</param>
        </sensor>
        <sensor name="forward_stereo_right">
          <param name="rgb_topic">/forward_stereo/right/image_raw</param>
          <param name="camera_info_topic">/forward_stereo/right/monocular_camera_info</param>
        </sensor>
      </xacro:if>
      <hardware>
          <plugin>picknik_mujoco_ros/MujocoSystem</plugin>
          <param name="mujoco_model">${mujoco_model}</param>
          <param name="mujoco_model_package">hangar_sim</param>
          <param name="render_publish_rate">20</param>
          <param name="tf_publish_rate">60</param>
          <!-- 10 Hz is the cadence the <rangefinder> path published scans at, kept
               so /scan_{front,rear} stay on their old timing. Note this does not
               bound render cost: the 3 tiles per scanner render on the render
               timer regardless, taking the scene from 3 offscreen renders per tick
               to 9. Not yet profiled. -->
          <param name="point_cloud_publish_rate">10</param>
          <param name="publish_odom">${publish_odom}</param>
          <param name="odom_child_frame">ridgeback_base_link</param>
          <param name="odom_rate">150</param>
          <!-- Zero z/roll/pitch in /odom for this planar base. The previous tag here,
               odom_zero_z, is not a recognized odom publisher parameter and was silently
               ignored; odom_planar is the real one. -->
          <param name="odom_planar">true</param>
          <!-- robot_state_publisher owns the live TF to ridgeback_base_link via the
               virtual-rail joint chain (driven by MuJoCo's own joint states), so the
               odom publisher must not broadcast a competing odom -> ridgeback_base_link
               edge. /odom messages keep flowing for Nav2. -->
          <param name="odom_publish_tf">false</param>
          <param name="odom_frame">odom</param>
          <param name="publish_mj_world_tf">false</param>
          <!-- Stop the site TF fill-in chain at the robot's base instead of walking to
               the MJCF worldbody. Without this, MuJoCo broadcasts
               base_platform -> ridgeback_base_link, a second parent for a frame that
               robot_state_publisher already publishes. -->
          <param name="base_link_name">ridgeback_base_link</param>
          <param name="mujoco_viewer">${mujoco_viewer}</param>
          <param name="mujoco_keyframe">default</param>
      </hardware>
      <sensor name="imu_site">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
      <!-- nyx: the Nyx nodes publish each camera's color and camera_info, so MuJoCo publishes only depth and points. -->
      <xacro:if
        value="${ dict(opengl=False, nyx=True, both=False)['$(arg camera_renderer)' or 'opengl'] }"
      >
        <sensor name="scene_camera">
          <param name="color_enabled">false</param>
        </sensor>
        <sensor name="wrist_camera">
          <param name="color_enabled">false</param>
        </sensor>
      </xacro:if>
      <!-- both: each renderer's color image goes under its own prefix, so no consumer reads one renderer while expecting the other. Depth and points stay unprefixed. -->
      <xacro:if
        value="${ dict(opengl=False, nyx=False, both=True)['$(arg camera_renderer)' or 'opengl'] }"
      >
        <sensor name="scene_camera">
          <param name="rgb_topic">scene_camera/opengl/color</param>
          <param name="camera_info_topic">scene_camera/opengl/camera_info</param>
        </sensor>
        <sensor name="wrist_camera">
          <param name="rgb_topic">wrist_camera/opengl/color</param>
          <param name="camera_info_topic">wrist_camera/opengl/camera_info</param>
        </sensor>
      </xacro:if>
    </ros2_control>
  </xacro:macro>
</robot>

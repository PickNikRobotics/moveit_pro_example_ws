#!/usr/bin/env bash
# One continuous session, arms alternating start by start.
# usage: abrun <label> <total starts> [arms]
set -euo pipefail
LABEL="$1"; STARTS="${2:-120}"; ARMS="${3:-baseline,tight,noseed}"
INST="${INST:-reseedflip}"
RT="moveit_pro_${INST}-runtime-1"
HARNESS_DIR="${HARNESS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
OUT="${OUT_DIR:-$PWD/runs}"
DDS="CYCLONEDDS_URI=${CYCLONEDDS_URI:-file://$HOME/.ros/cyclonedds.xml}"
SRC='source /opt/ros/jazzy/setup.bash; source /opt/overlay_ws/install/setup.bash;'

# The load-step counter is one file reached from two sides of the bind mount: the driver writes
# it at the CONTAINER's $USER_WS, loadstepper watches it at the HOST worktree root. Read the
# container's USER_WS rather than assuming it (the image bakes in whoever ran moveit_pro build)
# and pass the container-side path in explicitly, so the two sides cannot drift apart silently.
CONTAINER_WS="${CONTAINER_WS:-$(docker exec "$RT" sh -c 'echo $USER_WS' | tr -d '\r')}"
CONTAINER_LOADSTEP="${CONTAINER_LOADSTEP:-$CONTAINER_WS/log/.loadstep}"
HOST_WS="${WORKSPACE:-$(cd "$HARNESS_DIR/../../../.." && pwd)}"
HOST_LOADSTEP="${LOADSTEP_FILE:-$HOST_WS/log/.loadstep}"

mkdir -p "$OUT"

if [ "${LOADSTEP:-0}" != "0" ]; then
  echo "== load-step counter: container writes $CONTAINER_LOADSTEP =="
  echo "== load-step counter: loadstepper must watch $HOST_LOADSTEP (same file, host side) =="
fi

docker cp "$HARNESS_DIR/recorder4.py" "$RT:/tmp/recorder4.py"
docker cp "$HARNESS_DIR/navloop_ab.py" "$RT:/tmp/navloop_ab.py"
docker cp "$HARNESS_DIR/seed_constants.py" "$RT:/tmp/seed_constants.py"

docker exec -d -e "$DDS" "$RT" bash -lc \
  "$SRC python3 /tmp/recorder4.py --out /tmp/${LABEL}.jsonl --duration 9000 --label $LABEL > /tmp/${LABEL}.reclog 2>&1"
WARMUP="${WARMUP:-60}"
echo "== driver warmup ${WARMUP}s; loadstepper should be started with WARMUP=$WARMUP =="
sleep "$WARMUP"

docker exec -e "$DDS" -e "LOADSTEP_FILE=$CONTAINER_LOADSTEP" "$RT" bash -lc \
  "$SRC python3 -u /tmp/navloop_ab.py --starts $STARTS --arms '$ARMS' --out /tmp/${LABEL}.starts --clear-costmaps ${CLEAR:-1} --load-step ${LOADSTEP:-0} --rescue-m ${RESCUE:-2.0}" \
  2>&1 | tee "$OUT/${LABEL}.drivelog"

docker exec "$RT" bash -lc "pkill -TERM -f '[r]ecorder4.py --out /tmp/${LABEL}' || true"
sleep 6
docker exec "$RT" bash -lc "pkill -9 -f '[r]ecorder4.py --out /tmp/${LABEL}' || true"
docker cp "$RT:/tmp/${LABEL}.jsonl" "$OUT/${LABEL}.jsonl"
docker cp "$RT:/tmp/${LABEL}.starts" "$OUT/${LABEL}.starts"
echo "== [$LABEL] wrote $OUT/${LABEL}.jsonl =="

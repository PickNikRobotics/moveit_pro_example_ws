#!/usr/bin/env bash
# One continuous session, arms alternating start by start.
# usage: abrun <label> <total starts> [arms]
set -euo pipefail
LABEL="$1"; STARTS="${2:-120}"; ARMS="${3:-baseline,tight,noseed}"
INST="${INST:-reseedflip}"
RT="moveit_pro_${INST}-runtime-1"
HARNESS_DIR="${HARNESS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
OUT="${OUT_DIR:-$HARNESS_DIR/runs}"
DDS="CYCLONEDDS_URI=${CYCLONEDDS_URI:-file://$HOME/.ros/cyclonedds.xml}"
SRC='source /opt/ros/jazzy/setup.bash; source /opt/overlay_ws/install/setup.bash;'

# The load-step counter is one file reached from two sides of the bind mount: the driver writes
# it at the CONTAINER's $USER_WS, loadstepper watches it at the HOST worktree root. Read the
# container's USER_WS rather than assuming it (the image bakes in whoever ran moveit_pro build)
# and pass the container-side path in explicitly, so the two sides cannot drift apart silently.
CONTAINER_WS="${CONTAINER_WS:-$(docker exec "$RT" sh -c 'echo $USER_WS' | tr -d '\r')}"
CONTAINER_LOADSTEP="${CONTAINER_LOADSTEP:-$CONTAINER_WS/log/.loadstep}"
HOST_WS="${WORKSPACE:-$(cd "$HARNESS_DIR/../../../.." && pwd)}"
HOST_LOADSTEP="${LOADSTEP_FILE:-$HOST_WS/log/.loadstep}"

mkdir -p "$OUT"
OUT="$(cd "$OUT" && pwd)"
echo "== [$LABEL] recordings will be written to $OUT =="

if [ "${LOADSTEP:-0}" != "0" ]; then
  echo "== load-step counter: container writes $CONTAINER_LOADSTEP =="
  echo "== load-step counter: loadstepper must watch $HOST_LOADSTEP (same file, host side) =="
fi

docker cp "$HARNESS_DIR/recorder4.py" "$RT:/tmp/recorder4.py"
docker cp "$HARNESS_DIR/navloop_ab.py" "$RT:/tmp/navloop_ab.py"
docker cp "$HARNESS_DIR/seed_constants.py" "$RT:/tmp/seed_constants.py"

# The recorder runs detached with a 9000 s duration, so anything that ends this script without
# stopping it leaves it running for hours and the next session's recorder truncates the same
# file underneath it. The driver can abort on its own guards well before the last start, so
# teardown has to happen on every exit path, and a capture that explains the abort is exactly
# the one worth keeping -- a missing file is reported, never a reason to skip the rest.
TORN_DOWN=0
teardown() {
  local status=$?
  if [ "$TORN_DOWN" = "1" ]; then
    exit "$status"
  fi
  TORN_DOWN=1
  docker exec "$RT" bash -lc "pkill -TERM -f '[r]ecorder4.py --out /tmp/${LABEL}' || true" || true
  sleep 6
  docker exec "$RT" bash -lc "pkill -9 -f '[r]ecorder4.py --out /tmp/${LABEL}' || true" || true
  for ext in jsonl starts reclog; do
    if docker cp "$RT:/tmp/${LABEL}.${ext}" "$OUT/${LABEL}.${ext}" 2>/dev/null; then
      echo "== [$LABEL] wrote $OUT/${LABEL}.${ext} =="
    else
      echo "== [$LABEL] no /tmp/${LABEL}.${ext} in $RT; nothing copied out =="
    fi
  done
  exit "$status"
}

docker exec -d -e "$DDS" "$RT" bash -lc \
  "$SRC python3 /tmp/recorder4.py --out /tmp/${LABEL}.jsonl --duration 9000 --label $LABEL > /tmp/${LABEL}.reclog 2>&1"
trap teardown EXIT INT TERM

# A recorder that never came up (import error, unwritable --out, no rclpy in this container)
# would otherwise cost the whole drive session before anyone found out, and the log that
# explains it would not be among the files copied out.
rec_alive() {
  docker exec "$RT" bash -lc "pgrep -f '[r]ecorder4.py --out /tmp/${LABEL}' >/dev/null"
}
rec_size() {
  local s
  s="$(docker exec "$RT" bash -lc \
    "stat -c %s /tmp/${LABEL}.jsonl 2>/dev/null || echo -1" 2>/dev/null | tr -d '\r')"
  case "$s" in
    '' | *[!0-9-]*) s=-1 ;;
  esac
  printf '%s' "$s"
}
rec_fail() {
  echo "== [$LABEL] $1; refusing to drive an unrecorded session =="
  echo "---- /tmp/${LABEL}.reclog ----"
  docker exec "$RT" bash -lc "cat /tmp/${LABEL}.reclog 2>/dev/null || echo '(no recorder log)'" || true
  echo "---- end of recorder log ----"
  exit 1
}

sleep 3
rec_alive || rec_fail "recorder exited immediately"

# The recorder opens its output before the sample loop, so the file exists within milliseconds
# whether or not a single row is ever written -- the case when DDS discovery finds no /odom.
# Require the capture to be GROWING, measured ACROSS the warmup: discovery legitimately takes
# tens of seconds, and the warmup is dead time that is being spent anyway, so the guard must
# not be stricter than the wait it precedes.
rec_base="$(rec_size)"

WARMUP="${WARMUP:-60}"
echo "== driver warmup ${WARMUP}s; loadstepper should be started with WARMUP=$WARMUP =="
sleep "$WARMUP"

REC_CHECK="${REC_CHECK:-5}"
rec_up=0
rec_now=-1
for _ in $(seq 1 "$REC_CHECK"); do
  rec_alive || break
  rec_now="$(rec_size)"
  if [ "$rec_now" -gt 0 ] && [ "$rec_now" -gt "$rec_base" ]; then
    rec_up=1
    break
  fi
  sleep 2
done
if [ "$rec_up" != "1" ]; then
  rec_fail "recorder has not written a row across the ${WARMUP}s warmup (size ${rec_base} -> ${rec_now} bytes)"
fi
echo "== [$LABEL] recorder is up and writing (${rec_base} -> ${rec_now} bytes) =="

docker exec -e "$DDS" -e "LOADSTEP_FILE=$CONTAINER_LOADSTEP" "$RT" bash -lc \
  "$SRC python3 -u /tmp/navloop_ab.py --starts $STARTS --arms '$ARMS' --out /tmp/${LABEL}.starts --clear-costmaps ${CLEAR:-1} --load-step ${LOADSTEP:-0} --rescue-m ${RESCUE:-2.0}" \
  2>&1 | tee "$OUT/${LABEL}.drivelog"

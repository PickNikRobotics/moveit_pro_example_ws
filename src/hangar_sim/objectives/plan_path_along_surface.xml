<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Plan Path Along Surface">
  <BehaviorTree
    ID="Plan Path Along Surface"
    _description="Plan and execute a path following a surface"
    _favorite="true"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!--DIAGNOSTIC: capture the camera pose BEFORE the move as well. Paired
           camera-frame and world-frame saves let the exact camera pose be
           recovered, so comparing before/after answers directly whether the
           base actually travelled to the waypoint.-->
      <Decorator ID="ForceSuccess">
        <Control ID="Sequence">
          <Action
            ID="GetPointCloud"
            topic_name="/wrist_camera/points"
            message_out="{pre_cloud}"
            publisher_timeout_sec="5.000000"
            message_timeout_sec="5.000000"
          />
          <Action
            ID="SavePointCloudToFile"
            file_path="/__w/moveit_pro_example_ws/moveit_pro_example_ws/build/hangar_sim/test_results/hangar_sim"
            file_prefix="diag_premove_cam"
            point_cloud="{pre_cloud}"
          />
          <Action
            ID="TransformPointCloudFrame"
            input_cloud="{pre_cloud}"
            output_cloud="{pre_cloud}"
            target_frame="world"
          />
          <Action
            ID="SavePointCloudToFile"
            file_path="/__w/moveit_pro_example_ws/moveit_pro_example_ws/build/hangar_sim/test_results/hangar_sim"
            file_prefix="diag_premove_world"
            point_cloud="{pre_cloud}"
          />
        </Control>
      </Decorator>
      <SubTree
        ID="Move to Waypoint (JTC)"
        _collapsed="true"
        acceleration_scale_factor="1.0"
        controller_names="joint_trajectory_controller"
        joint_group_name="manipulator"
        link_padding="0.0"
        seed="0"
        velocity_scale_factor="1.0"
        waypoint_name="Look at Plane"
        controller_action_server="/joint_trajectory_controller/follow_joint_trajectory"
      />
      <!--Get a point cloud and crop it to the area of interest-->
      <Action
        ID="GetPointCloud"
        topic_name="/wrist_camera/points"
        message_out="{point_cloud}"
        publisher_timeout_sec="5.000000"
        message_timeout_sec="5.000000"
      />
      <!--DIAGNOSTIC: save the RAW camera-frame cloud first. Point order is
           preserved through the transform, so the rigid transform between this
           and the world-frame save below IS the world->camera transform CI
           actually used - which yields CI's camera pose as a measured number.-->
      <Decorator ID="ForceSuccess">
        <Action
          ID="SavePointCloudToFile"
          file_path="/__w/moveit_pro_example_ws/moveit_pro_example_ws/build/hangar_sim/test_results/hangar_sim"
          file_prefix="diag_camframe"
          point_cloud="{point_cloud}"
        />
      </Decorator>
      <Action
        ID="TransformPointCloudFrame"
        input_cloud="{point_cloud}"
        output_cloud="{point_cloud}"
        target_frame="world"
      />
      <!--DIAGNOSTIC: write the transformed, pre-crop cloud into the directory CI
           uploads as an artifact, so its true world-frame extent can be measured
           from a genuinely failing CI run. Wrapped in ForceSuccess so a failed
           write cannot change the objective's outcome and mask the real failure.-->
      <Decorator ID="ForceSuccess">
        <Action
          ID="SavePointCloudToFile"
          file_path="/__w/moveit_pro_example_ws/moveit_pro_example_ws/build/hangar_sim/test_results/hangar_sim"
          file_prefix="diag_precrop"
          point_cloud="{point_cloud}"
        />
      </Decorator>
      <Action
        ID="CreatePoseStamped"
        reference_frame="world"
        pose_stamped="{roi_frame}"
        position_xyz="0;12;1.7"
      />
      <Action
        ID="CropPointsInBox"
        crop_box_centroid_pose="{roi_frame}"
        point_cloud="{point_cloud}"
        point_cloud_cropped="{point_cloud}"
        crop_box_size="5;15;0.2"
      />
      <!--Visualize the cropped point cloud-->
      <Action
        ID="SendPointCloudToUI"
        pcd_topic="/pcd_pointcloud_captures"
        point_cloud="{point_cloud}"
      />
      <!--Get the centroid of the cropped point cloud and use it to get a contour-->
      <Action
        ID="GetCentroidFromPointCloud"
        output_pose="{centroid}"
        point_cloud="{point_cloud}"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="centroid"
        marker_size="0.200000"
        pose="{centroid}"
      />
      <Action
        ID="GetContourFromPointCloudSlice"
        contour_path="{contour_path}"
        max_pose_spacing="0.200000"
        hull_alpha="-1.000000"
        input_cloud="{point_cloud}"
        slice_distance_from_plane="0.100000"
        slice_plane="{centroid}"
        contour_crop_angle_span="3.19"
        contour_crop_angle_start="1.58"
      />
      <Action
        ID="VisualizePath"
        marker_lifetime="0.000000"
        marker_name="path"
        path="{contour_path}"
        pose_marker_size="0.100000"
        show_poses="true"
      />
      <!--Plan and execute a path following the contour at a small distance-->
      <Action
        ID="PlanCartesianPath"
        blending_radius="0.0050000"
        ik_cartesian_space_density="0.010000"
        ik_joint_space_density="0.100000"
        joint_trajectory_msg="{joint_trajectory_msg}"
        path="{contour_path}"
        planning_group_name="manipulator"
        position_only="false"
        trajectory_timing="[{mode: time_optimal}]"
        tip_offset="0;0;0.1;0;0;0"
        debug_solution="{debug_solution}"
      />
      <Action
        ID="ExecuteTrajectory"
        execution_pipeline="jtc"
        controller_action_name="/joint_trajectory_controller/follow_joint_trajectory"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Plan Path Along Surface">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Training Examples" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

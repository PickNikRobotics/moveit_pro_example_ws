<?xml version="1.0" encoding="utf-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Move to Pose No Preview">
  <BehaviorTree
    ID="Move to Pose No Preview"
    _description="Plan and execute motion to a Cartesian coordinate pose in a ROS message type, using inverse kinematics."
    target_pose="{target_pose}"
  >
    <Control ID="Sequence">
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_controller"
      />
      <Action
        ID="InitializeMTCTask"
        task_id="move_to_pose"
        task="{move_to_pose_task}"
      />
      <Action ID="SetupMTCCurrentState" task="{move_to_pose_task}" />
      <Control ID="Sequence" name="Setup pose motion">
        <Control ID="Sequence" name="Wrap target pose">
          <Action
            ID="ResetPoseStampedVector"
            vector="{setup_mtc_pose_targets_1}"
          />
          <Action
            ID="PushBackVector"
            input_vector="{setup_mtc_pose_targets_1}"
            element="{target_pose}"
            output_vector="{setup_mtc_pose_targets_1}"
          />
          <Action ID="Script" code="setup_mtc_pose_max_ik_1 := 8" />
          <Decorator
            ID="Precondition"
            if="setup_mtc_pose_max_ik_1 == 0"
            else="SUCCESS"
          >
            <Action ID="Script" code="setup_mtc_pose_max_ik_1 = 8" />
          </Decorator>
        </Control>
        <Action
          ID="SetupMTCConnectWithProRRT"
          planning_group_name="manipulator"
          velocity_scale_factor="1.000000"
          acceleration_scale_factor="1.000000"
          trajectory_sampling_rate="100"
          max_iterations="5000"
          task="{move_to_pose_task}"
        />
        <Action
          ID="SetupMTCBatchPoseIK"
          task="{move_to_pose_task}"
          target_poses="{setup_mtc_pose_targets_1}"
          monitored_stage="current state"
          ik_group="manipulator"
          end_effector_link="grasp_link"
          end_effector_group=""
          ik_timeout_s="1.0"
          max_ik_solutions="{setup_mtc_pose_max_ik_1}"
          spawn_top_k="0"
        />
      </Control>
      <Action
        ID="PlanMTCTask"
        solution="{move_to_pose_solution}"
        task="{move_to_pose_task}"
      />
      <Action
        ID="ExecuteMTCSolution"
        solution="{move_to_pose_solution}"
        execution_pipeline="jtc"
        controller_action_name="/joint_trajectory_controller/follow_joint_trajectory"
        goal_duration_tolerance="-1.000000"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Move to Pose No Preview">
      <inout_port name="target_pose" default="{target_pose}" />
      <MetadataFields>
        <Metadata subcategory="Motion - Execute" />
        <Metadata runnable="false" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Localize Robot">
  <!--//////////-->
  <BehaviorTree
    ID="Localize Robot"
    _description="Tell the localizer where the robot is. Prompts for a click on the map, then seeds the particle filter with that pose. Run this once after startup, before navigating, and again any time the robot is moved without driving."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!--AMCL runs with set_initial_pose: false, because in production a robot does not power on
           at a known pose. Until this Objective runs, the particle filter is unseeded, AMCL
           publishes no map -> odom transform at all, and navigation cannot localize.-->
      <Action
        ID="GetPoseFromUser"
        name="Ask the operator where the robot is"
        is_normal="true"
        pose_prompt="Click the robot's current location on the map, dragging to set its heading"
        user_pose="{clicked_pose}"
        view_name="Visualization"
      />
      <!--The UI returns the click in the planning frame - 'world' on this robot, hardcoded in the
           UI's pose-utils.ts - and 'world' sits under 'odom', which drifts relative to 'map'. The
           seed needs map coordinates and cannot tell the difference, so convert explicitly rather
           than relying on the two happening to coincide. They coincide exactly once: at startup,
           before anything has moved, which is the one time you would not notice the bug.-->
      <Action
        ID="TransformPoseFrame"
        name="Convert the click into the map frame"
        input_pose="{clicked_pose}"
        output_pose="{initial_pose}"
        target_frame_id="map"
      />
      <!--0.5 m is not a claim that the click is good to half a metre. It is the spread this filter
           takes cleanly, and it is also what sets the resolution of any refinement that follows:
           5000 particles over 0.5 m sit a few centimetres apart, and a refinement can only ever
           select among the poses this scatter drew.

           Do NOT widen yaw_std_dev. Heading is the axis a click is worst at, and a cloud spread
           wide in yaw is exactly how a filter converges facing the wrong way.-->
      <Action
        ID="SeedLocalizationAtPose"
        name="Seed the particle filter at the clicked pose"
        pose="{initial_pose}"
        xy_std_dev="0.500000"
        yaw_std_dev="0.260000"
        initial_pose_topic="/initialpose"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Localize Robot">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Segment Image from Text Prompt">
  <!--//////////-->
  <BehaviorTree
    ID="Segment Image from Text Prompt"
    _description="Run text based segmentation and visualize the masks."
    _favorite="false"
  >
    <Control ID="Sequence">
      <!--The base pose the View Boxes waypoint was recorded at, in the map frame.-->
      <Action
        ID="CreatePoseStamped"
        reference_frame="map"
        position_xyz="-7.5;5.5;0.0"
        orientation_xyzw="0;0;-0.9757234;0.2190067"
        pose_stamped="{boxes_viewpoint}"
      />
      <SubTree
        ID="Navigate Base to Pose"
        _collapsed="true"
        goal_pose="{boxes_viewpoint}"
      />
      <!--arm_only: the waypoint holds the arm joints only, and joint-space planners keep the base at one pose.-->
      <SubTree
        ID="Move to Named Waypoint (JTC)"
        _collapsed="true"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_controller"
        joint_group_name="arm_only"
        collision_check_params="[{override_scene_link_padding: true, link_padding: 0.0}]"
        velocity_scale_factor="1.0"
        waypoint_name="View Boxes"
      />
      <SubTree
        ID="Segment Image from Text Prompt Subtree"
        _collapsed="true"
        masks_visualization_topic="/masks_visualization"
        model_package="moveit_pro_sam3"
        confidence_threshold="0.25"
        image_topic_name="/wrist_camera/color"
        text_prompt="a single small orange cube box"
        masks2d="{masks2d}"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Segment Image from Text Prompt">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Perception - ML" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

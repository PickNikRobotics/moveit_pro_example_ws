<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Build Map">
  <!--Requires slam_toolbox to be running in mapping mode, which the persist launch starts when config.yaml urdf_params sets slam to true. Its parameters live in the slam_toolbox block of params/nav2_params.yaml.-->
  <BehaviorTree
    ID="Build Map"
    _description="Teleoperate the robot to explore the hangar while slam_toolbox builds an occupancy grid, then save that map on the operator's confirmation."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!--Fail before the operator drives anywhere if mapping is off.-->
      <Control ID="Fallback">
        <Action
          ID="WaitForServiceAvailable"
          service_name="/slam_toolbox/save_map"
          timeout="3.000000"
        />
        <Control ID="Sequence">
          <Action
            ID="LogMessage"
            log_level="ERROR"
            message="slam_toolbox is not running. Set slam to true under urdf_params in config.yaml, then restart the Runtime."
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <Action
        ID="WaitForUserDecision"
        prompt="To drive the base, switch Mode to Teleoperation, open the Joint tab, and select the manipulator planning group. Mapping uses both lidars. When done, stop moving, return to Objectives, and press Continue to save the map."
        approve_label="Start"
        reject_label="Cancel"
        timeout_sec="3600.000000"
      />
      <!--Mode 3 matches the other Request Teleoperation callers: modes 1 and 2 read the controllers that only the first feedback from the Desktop App sets.-->
      <SubTree
        ID="Request Teleoperation"
        controller_action_server="/joint_trajectory_controller/follow_joint_trajectory"
        joint_trajectory_controller_name="joint_trajectory_controller"
        execution_pipeline="jtc"
        enable_user_interaction="true"
        initial_teleop_mode="3"
        user_interaction_prompt="Switch Mode to Teleoperation and drive the base around the hangar to build the map. Then stop moving, return to Objectives, and press Continue to save the map, or Abort to discard it."
      />
      <!--Relative name: slam_toolbox writes it under its own working directory, not into this package.-->
      <Action
        ID="CallSaveMapService"
        map_name="hangar_map"
        service_name="/slam_toolbox/save_map"
        response_timeout="30.000000"
        wait_for_server_available_timeout="3.000000"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Build Map">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

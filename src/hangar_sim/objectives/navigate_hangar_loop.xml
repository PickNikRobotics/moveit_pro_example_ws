<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Navigate Hangar Loop">
  <!--//////////-->
  <BehaviorTree
    ID="Navigate Hangar Loop"
    _description="Drive the base on a fixed closed loop around the aircraft and return to the spawn pose, without user input. The route is repeatable, so odometry estimates can be compared against ground truth run to run."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <Action ID="SetInitialPose" robot_frame_id="ridgeback_base_link" />
      <Action
        ID="CreatePoseStamped"
        reference_frame="base_link"
        pose_stamped="{start}"
      />
      <!-- Waypoints are in the map frame and sit in open floor with at least 1.75 m of clearance, and each leg runs down an open corridor clear of the wing tips. Each heading faces the next leg so the forward cameras look along the direction of travel. The last waypoint is the spawn pose, which closes the loop. -->
      <Action ID="ResetPoseStampedVector" vector="{route}" />
      <Action
        ID="CreatePoseStamped"
        reference_frame="map"
        position_xyz="14.75;3.0;0.0"
        orientation_xyzw="0;0;0.7071068;0.7071068"
        pose_stamped="{waypoint}"
      />
      <Action
        ID="PushBackVector"
        input_vector="{route}"
        element="{waypoint}"
        output_vector="{route}"
      />
      <Action
        ID="CreatePoseStamped"
        reference_frame="map"
        position_xyz="14.75;36.0;0.0"
        orientation_xyzw="0;0;1;0"
        pose_stamped="{waypoint}"
      />
      <Action
        ID="PushBackVector"
        input_vector="{route}"
        element="{waypoint}"
        output_vector="{route}"
      />
      <Action
        ID="CreatePoseStamped"
        reference_frame="map"
        position_xyz="-14.5;36.0;0.0"
        orientation_xyzw="0;0;-0.7071068;0.7071068"
        pose_stamped="{waypoint}"
      />
      <Action
        ID="PushBackVector"
        input_vector="{route}"
        element="{waypoint}"
        output_vector="{route}"
      />
      <Action
        ID="CreatePoseStamped"
        reference_frame="map"
        position_xyz="-14.5;9.0;0.0"
        orientation_xyzw="0;0;-0.2741896;0.9616757"
        pose_stamped="{waypoint}"
      />
      <Action
        ID="PushBackVector"
        input_vector="{route}"
        element="{waypoint}"
        output_vector="{route}"
      />
      <Action
        ID="CreatePoseStamped"
        reference_frame="map"
        position_xyz="0.0;0.0;0.0"
        orientation_xyzw="0;0;0;1"
        pose_stamped="{waypoint}"
      />
      <Action
        ID="PushBackVector"
        input_vector="{route}"
        element="{waypoint}"
        output_vector="{route}"
      />
      <Action
        ID="SwitchController"
        activate_controllers="platform_velocity_controller_nav2"
        deactivate_controllers="velocity_force_controller;joint_trajectory_controller;platform_velocity_controller"
      />
      <Decorator ID="ForEach" vector_in="{route}" out="{goal}" index="{index}">
        <Control ID="Sequence">
          <Action
            ID="ComputePathToPoseAction"
            action_name="/compute_path_to_pose"
            goal="{goal}"
            ignore_stamp_time="true"
            path="{path}"
            planning_time="{planning_time}"
            start="{start}"
            timeout_sec="-1.000000"
            use_start="false"
            planner_id="GridBased"
          />
          <Action
            ID="FollowPathAction"
            action_name="/follow_path"
            controller_id="FollowPath"
            distance_to_goal="{distance_to_goal}"
            goal_checker_id="general_goal_checker"
            path="{path}"
            speed="{speed}"
            timeout_sec="-1.000000"
          />
        </Control>
      </Decorator>
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_controller"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Navigate Hangar Loop">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

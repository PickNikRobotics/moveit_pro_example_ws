<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Navigate to Clicked Point">
  <!--//////////-->
  <BehaviorTree
    ID="Navigate to Clicked Point"
    _description="Navigate to a point clicked by the user in the UI. If the robot is not localized yet, this first asks you to place it on the map, then drives."
    _favorite="true"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!--Seeding from TF is what this Behavior does: it reads map -> ridgeback_base_link and hands
           that pose to the filter. That only ever worked at cold boot because the transform was
           coming from the simulator, and amcl was self-seeding at the spawn pose on activation.
           With set_initial_pose false the filter starts holding nothing, map -> odom does not
           exist, and this lookup has nothing to resolve through.

           So this Objective did not stop working - it stopped being CARRIED BY GROUND TRUTH, which
           is the crutch this whole capability exists to remove. The order is localize, then
           navigate, and that is the order on hardware too.

           The Fallback is CONDITIONAL, not unconditional. A filter with a live estimate takes the
           first branch and proceeds exactly as before, with no extra prompt; only a run that cannot
           read the robot's pose reaches the second branch, and that branch localizes the robot here
           rather than sending the operator away to a different Objective. The cost is one extra
           interaction on the first run after boot: the Objective stops and waits for the marker
           before it drives, which is correct, because it cannot navigate without knowing where it
           is.

           KNOWN LIMITATION, and the reason the messages below name a symptom rather than a cause.
           SetInitialPose fails on ANY unavailable map -> ridgeback_base_link, and this tree cannot
           tell "the filter was never seeded" from "a good estimate went briefly unavailable" -
           amcl restarting, stalling or pausing longer than the TF buffer window produces the same
           observation. Nothing in the tree carries the history that would separate them. That
           matters because the second case routes an already-localized robot into Localize Robot,
           which localize_robot.xml records as a known limitation: on gate rejection the restore
           writes the operator's new pose back, and a filter measured at 9.4 cm error ended at
           95.6 cm that way. Distinguishing the two cases is follow-up work; until then the
           messages say what was observed and warn about the replacement.-->
      <Control
        ID="Fallback"
        name="Re-seed from the current estimate, or localize first"
      >
        <Action ID="SetInitialPose" robot_frame_id="ridgeback_base_link" />
        <!--Gated on a UI actually being attached. Note what IsUserAvailable actually tests: it
             asks whether anything SUBSCRIBES to /failure_reason_collector, and returns FAILURE
             when nothing does. Its own class docstring still says it looks for a
             /trajectory_bridge node; that is stale, and believing it would send someone grepping
             for a node that never existed here. So the headless fast-fail rests specifically on
             nothing subscribing to /failure_reason_collector, which is checkable at runtime and
             was checked: on the running headless simulator that topic had 0 subscribers and 1
             publisher, and no trajectory_bridge node existed at all.

             The effect is that this branch is skipped in under a second on a headless run rather
             than blocking on the marker prompt inside Localize Robot until the objective timeout
             expires. With an operator present the branch runs and localizes in place, which is
             the whole point of it.-->
        <Control
          ID="Sequence"
          name="An operator is here, so localize before navigating"
        >
          <Action ID="IsUserAvailable" />
          <Action
            ID="LogMessage"
            log_level="warn"
            message="Asking you to localize before navigating: map -> ridgeback_base_link did not resolve, so the robot's current pose cannot be read. Either the particle filter has not been seeded yet, or an estimate it did have has become unavailable - this Objective cannot tell which. Place the marker on the robot to localize it, and navigation will continue on its own. NOTE: if the robot was in fact already localized, placing the marker REPLACES that estimate with the pose you place."
          />
          <SubTree ID="Localize Robot" />
        </Control>
        <!--This branch is reached on ANY failure of the one above, including one that happened
             long after the operator answered the marker, so it re-tests the condition rather than
             assuming it. Without the Inverter, an operator whose Localize Robot run was rejected
             by the fit-to-map gate would be told "no user interface is attached" seconds after
             placing a marker, with the gate's real message buried above it. With it, that case
             fails here immediately and the last thing logged is the gate's own accurate reason.-->
        <Control ID="Sequence" name="Pose unreadable, and nobody to ask">
          <Decorator ID="Inverter" name="Only when no UI is attached">
            <Action ID="IsUserAvailable" />
          </Decorator>
          <Action
            ID="LogMessage"
            log_level="error"
            message="Cannot navigate: map -> ridgeback_base_link did not resolve, so the robot's current pose cannot be read. Either the particle filter has not been seeded yet, or an estimate it did have has become unavailable - this Objective cannot tell which. No user interface is attached, so the localization marker cannot be presented here. Run the &quot;Localize Robot&quot; Objective from an operator station - noting that if the robot was already localized, that replaces its estimate with the pose you place."
          />
          <Action ID="AlwaysFailure" name="Stop before planning blind" />
        </Control>
      </Control>
      <Action
        ID="CreatePoseStamped"
        reference_frame="base_link"
        pose_stamped="{start}"
      />
      <Action
        ID="SwitchController"
        activate_controllers="platform_velocity_controller_nav2"
        deactivate_controllers="velocity_force_controller;joint_trajectory_controller;platform_velocity_controller"
      />
      <Action
        ID="GetPoseFromUser"
        is_normal="true"
        pose_prompt="Choose a goal waypoint by clicking in the 3D Visualization pane"
        user_pose="{goal}"
        view_name="Visualization"
      />
      <Action
        ID="ComputePathToPoseAction"
        action_name="/compute_path_to_pose"
        goal="{goal}"
        ignore_stamp_time="true"
        path="{path}"
        planning_time="{planning_time}"
        start="{start}"
        timeout_sec="-1.000000"
        use_start="false"
        planner_id="GridBased"
      />
      <Action ID="WaitForUserPathApproval" path="{path}" />
      <Action
        ID="FollowPathAction"
        action_name="/follow_path"
        controller_id="FollowPath"
        distance_to_goal="{distance_to_goal}"
        goal_checker_id="general_goal_checker"
        path="{path}"
        speed="{speed}"
        timeout_sec="-1.000000"
      />
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_controller"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Navigate to Clicked Point">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Navigate to Clicked Point">
  <!--//////////-->
  <BehaviorTree
    ID="Navigate to Clicked Point"
    _description="Navigate to a point clicked by the user in the UI"
    _favorite="true"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!--Seeding from TF is what this Behavior does: it reads map -> ridgeback_base_link and hands
           that pose to the filter. That only ever worked at cold boot because the transform was
           coming from the simulator, and amcl was self-seeding at the spawn pose on activation.
           With set_initial_pose false the filter starts holding nothing, map -> odom does not
           exist, and this lookup has nothing to resolve through.

           So this Objective did not stop working - it stopped being CARRIED BY GROUND TRUTH, which
           is the crutch this whole capability exists to remove. The order is localize, then
           navigate, and that is the order on hardware too.

           The Fallback is CONDITIONAL, not unconditional. An already-seeded filter takes the first
           branch and proceeds exactly as before, with no extra prompt; only a cold-boot run reaches
           the second branch, and that branch localizes the robot here rather than sending the
           operator away to a different Objective. The cost is one extra interaction on the first
           run after boot: the Objective stops and waits for the marker before it drives, which is
           correct, because it cannot navigate without knowing where it is.-->
      <Control ID="Fallback" name="Re-seed from the current estimate, or localize first">
        <Action ID="SetInitialPose" robot_frame_id="ridgeback_base_link" />
        <Control ID="Sequence" name="The filter has no estimate to re-seed from">
          <Action
            ID="LogMessage"
            log_level="warn"
            message="Asking you to localize before navigating: the particle filter has not been seeded yet, so map -> ridgeback_base_link does not resolve and the robot's current pose cannot be read. Place the marker on the robot to localize it, and this Objective will continue on its own."
          />
          <SubTree ID="Localize Robot" />
        </Control>
      </Control>
      <Action
        ID="CreatePoseStamped"
        reference_frame="base_link"
        pose_stamped="{start}"
      />
      <Action
        ID="SwitchController"
        activate_controllers="platform_velocity_controller_nav2"
        deactivate_controllers="velocity_force_controller;joint_trajectory_controller;platform_velocity_controller"
      />
      <Action
        ID="GetPoseFromUser"
        is_normal="true"
        pose_prompt="Choose a goal waypoint by clicking in the 3D Visualization pane"
        user_pose="{goal}"
        view_name="Visualization"
      />
      <Action
        ID="ComputePathToPoseAction"
        action_name="/compute_path_to_pose"
        goal="{goal}"
        ignore_stamp_time="true"
        path="{path}"
        planning_time="{planning_time}"
        start="{start}"
        timeout_sec="-1.000000"
        use_start="false"
        planner_id="GridBased"
      />
      <Action ID="WaitForUserPathApproval" path="{path}" />
      <Action
        ID="FollowPathAction"
        action_name="/follow_path"
        controller_id="FollowPath"
        distance_to_goal="{distance_to_goal}"
        goal_checker_id="general_goal_checker"
        path="{path}"
        speed="{speed}"
        timeout_sec="-1.000000"
      />
      <Action
        ID="SwitchController"
        activate_controllers="joint_trajectory_controller"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Navigate to Clicked Point">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

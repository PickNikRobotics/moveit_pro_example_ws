<?xml version="1.0" encoding="UTF-8" ?>
<root
  BTCPP_format="4"
  main_tree_to_execute="Refine Localization In Place Subtree"
>
  <!--//////////-->
  <BehaviorTree
    ID="Refine Localization In Place Subtree"
    _description="Seeds the localizer at a pose, refines it in place, and keeps the result only if it fits the scan. Otherwise restores restore_pose."
    _favorite="false"
  >
    <Control ID="Sequence" name="root">
      <Action ID="SetInitialPose" name="Seed the filter" pose="{seed_pose}" />
      <!--A rejected seed restores the complete captured estimate, or restore_pose when there was no prior estimate.-->
      <Control ID="Fallback" name="Refine and verify, or restore">
        <Control ID="Sequence" name="Refine and verify">
          <Action
            ID="WaitForDuration"
            name="Let the filter take the seed"
            delay_duration="0.300000"
          />
          <!--Each call updates the filter on the next scan; the wait gives each call a fresh scan.-->
          <Decorator
            ID="RepeatUnlessFailureEachTick"
            name="Refine in place"
            num_cycles="{num_updates}"
          >
            <Control ID="Sequence">
              <Action
                ID="CallEmptyService"
                name="Request a filter update"
                service_name="/request_nomotion_update"
                response_timeout="2.000000"
              />
              <Action ID="WaitForDuration" delay_duration="0.150000" />
            </Control>
          </Decorator>
          <Action
            ID="GetLatestTransform"
            name="Read the refined pose"
            target_frame_id="map"
            source_frame_id="ridgeback_base_link"
            transform="{refined_transform}"
          />
          <Action
            ID="ConvertTransformStampedToPoseStamped"
            transform_stamped="{refined_transform}"
            pose_stamped="{refined_pose}"
          />
          <!--Each lidar must fit the map. max_range mirrors amcl laser_max_range.-->
          <Action ID="GetOccupancyGrid" topic_name="/map" message_out="{map}" />
          <Action
            ID="GetLaserScan"
            topic_name="/scan_front_filtered"
            message_out="{front_scan}"
          />
          <Action
            ID="ScanMatchResidual"
            name="Check the front lidar against the map"
            pose="{refined_pose}"
            scan="{front_scan}"
            map="{map}"
            base_frame_id="ridgeback_base_link"
            max_range="25.000000"
            inlier_distance="{inlier_distance}"
            min_inlier_fraction="{min_inlier_fraction}"
          />
          <Action
            ID="GetLaserScan"
            topic_name="/scan_rear_filtered"
            message_out="{rear_scan}"
          />
          <Action
            ID="ScanMatchResidual"
            name="Check the rear lidar against the map"
            pose="{refined_pose}"
            scan="{rear_scan}"
            map="{map}"
            base_frame_id="ridgeback_base_link"
            max_range="25.000000"
            inlier_distance="{inlier_distance}"
            min_inlier_fraction="{min_inlier_fraction}"
          />
          <Action
            ID="LogMessage"
            log_level="info"
            message="Localization refined."
          />
        </Control>
        <Control ID="Sequence" name="Restore and fail">
          <Action
            ID="LogMessage"
            log_level="error"
            message="Localization failed. If the scans did not fit the map, run Localize Robot."
          />
          <Control
            ID="IfThenElse"
            name="Restore captured uncertainty or the first seed"
          >
            <Action
              ID="ScriptCondition"
              code="has_restore_estimate == 'true'"
            />
            <Action
              ID="SetInitialPose"
              name="Restore the previous estimate and covariance"
              estimate="{restore_estimate}"
            />
            <Action
              ID="SetInitialPose"
              name="No previous estimate: restore the seed"
              pose="{restore_pose}"
            />
          </Control>
          <Action
            ID="WaitForDuration"
            name="Let the filter take the restore"
            delay_duration="0.300000"
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
    </Control>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="Refine Localization In Place Subtree">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
      <input_port
        name="seed_pose"
        default="{initial_pose}"
        type="geometry_msgs::msg::PoseStamped"
      >
        Pose to seed, in map.
      </input_port>
      <input_port
        name="restore_pose"
        default="{restore_pose}"
        type="geometry_msgs::msg::PoseStamped"
      >
        Pose to restore if the result is rejected, in map.
      </input_port>
      <input_port
        name="restore_estimate"
        default="{restore_estimate}"
        type="geometry_msgs::msg::PoseWithCovarianceStamped"
      >
        Captured pose and complete covariance to restore, in map.
      </input_port>
      <input_port
        name="has_restore_estimate"
        default="false"
        type="std::string"
      >
        Restore the captured estimate when true; otherwise use restore_pose.
      </input_port>
      <input_port name="num_updates" default="20" type="int">
        Number of filter updates.
      </input_port>
      <input_port name="inlier_distance" default="0.15" type="double">
        A beam fits if it lands within this distance of a wall, metres.
      </input_port>
      <input_port name="min_inlier_fraction" default="0.5" type="double">
        Min fraction of beams that fit, per lidar. Measured at 6 hangar_map
        spots: true pose 0.57+, 0.5 m or 5 deg off 0.28 or less.
      </input_port>
    </SubTree>
  </TreeNodesModel>
</root>

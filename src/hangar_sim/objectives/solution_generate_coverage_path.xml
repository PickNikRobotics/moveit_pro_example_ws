<?xml version="1.0" encoding="utf-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Solution - Generate coverage path">
  <!--//////////-->
  <BehaviorTree
    ID="Solution - Generate coverage path"
    _description=""
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <SubTree
        ID="Move to Waypoint (JTC)"
        _collapsed="true"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_controller"
        joint_group_name="manipulator"
        collision_check_params="[{override_scene_link_padding: true, link_padding: 0.0}]"
        velocity_scale_factor="1.0"
        waypoint_name="Look at Plane"
      />
      <Action
        ID="CreatePoseStamped"
        reference_frame="grasp_link"
        pose_stamped="{pose_stamped}"
        orientation_xyzw="0;1;0;0"
        position_xyz="0.25;-0.25;1"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="pose"
        marker_size="0.100000"
        pose="{pose_stamped}"
      />
      <Action
        ID="GenerateSurfaceCoveragePath"
        coverage_path="{pose_stamped_vector}"
        region_pose="{pose_stamped}"
        region_dimensions="0.5;0.5;0"
        raster_layout="[{line_spacing: 0.1, point_spacing: 0.25}]"
        standoff="0"
        orientation_offset="0;0;3.14159265"
      />
      <Action
        ID="VisualizePath"
        marker_lifetime="0.000000"
        path="{pose_stamped_vector}"
      />
      <Action
        ID="PlanCartesianPath"
        blending_radius="0.020000"
        debug_solution="{debug_solution}"
        ik_cartesian_space_density="0.010000"
        ik_joint_space_density="0.100000"
        joint_trajectory_msg="{joint_trajectory_msg}"
        path="{pose_stamped_vector}"
        planning_group_name="manipulator"
        cartesian_constraint="[{constraint_type: position_and_orientation}]"
        tip_links="grasp_link"
        trajectory_timing="[{mode: time_optimal}]"
      />
      <Action
        ID="ExecuteTrajectory"
        execution_pipeline="jtc"
        controller_action_name="/joint_trajectory_controller/follow_joint_trajectory"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Solution - Generate coverage path">
      <MetadataFields>
        <Metadata subcategory="Training Examples" />
        <Metadata runnable="true" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

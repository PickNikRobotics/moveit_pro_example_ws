<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Mirror SO101 Follower">
  <BehaviorTree
    ID="Mirror SO101 Follower"
    _description="Hold the twin in mirroring mode: so101_arm_bridge drives joint_trajectory_controller for as long as this Objective runs. In this phase the bridge is in --fake mode and the twin follows a slow sine."
    _favorite="true"
  >
    <!--
      The bridge only mirrors while these ticks keep arriving, so mirroring
      stops on its own when this Objective is stopped. That is deliberate: the
      trajectory controller has one owner at a time, and a plan and the bridge
      would otherwise fight over it. Stop this Objective before pressing Plan.
    -->
    <Control ID="Sequence" name="root">
      <Action
        ID="LogMessage"
        log_level="info"
        message="Mirroring the SO-101 follower. Stop this Objective before planning or executing."
      />
      <Decorator ID="KeepRunningUntilFailure">
        <Control ID="Sequence" name="Keep the bridge mirroring">
          <Action
            ID="CallTriggerService"
            service_name="/so101_arm_bridge/mirror"
            response_timeout="3.0"
            wait_for_server_available_timeout="10.0"
          />
          <Action ID="WaitForDuration" delay_duration="0.2" />
        </Control>
      </Decorator>
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Mirror SO101 Follower">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="SO-101" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
